#!/usr/bin/env bash
# sensei — the only external dependency of tmux-sensei.conf
# One script, POSIX-ish bash, no packages. Subcommands are called from keybinds
# and hooks in the config; every one of them is safe to run by hand.
#
#   sensei vpn                      -> status-bar VPN/iface indicator
#   sensei log toggle  <session>    -> arm/disarm evidence logging for a session
#   sensei log inherit <session> <pane_id>
#   sensei dump  <pane_id> <session>-> flush scrollback to the case file
#   sensei notes <session>          -> open the case notebook
#   sensei case  <name>             -> new session skeleton for a target
#   sensei burst <session> <target> [profile] -> STAGE a chain from burst.conf (never executes)
#   sensei save [name] / restore [name]
#   sensei strip <logfile>          -> ANSI-strip a log for reporting
#   sensei bufmenu                  -> numbered paste-buffer pick-list
#   sensei findall <session> <pat>  -> grep every pane's scrollback, pick-list of hits
#   sensei cmdtime <pane_id> <cmd>  -> elapsed time for the pane border
#   sensei experiment <name>        -> scaffold + open a local.d/ drop-in snippet
set -u
TM=(${SENSEI_TMUX:-tmux})          # socket-aware: SENSEI_TMUX="tmux -L lab" for testing
LOOT="${SENSEI_LOOT:-$HOME/loot}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sensei"
BURST_CONF="${SENSEI_BURST_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/burst.conf}"
# no blanket `mkdir -p "$LOOT" "$STATE"` here on purpose — every function that
# actually writes into one already ensures its own path (log_arm_pane, dump,
# notes, case, save), and this script also runs as `sensei vpn`/`cmdtime` on
# every status-bar/pane-border refresh; forcing two mkdir stats on every one
# of those calls for directories they never touch is pure overhead.
SENSEI_REPO="${SENSEI_REPO:-sudosuraj/tmux-sensei}"
SENSEI_BRANCH="${SENSEI_BRANCH:-main}"

die() { printf '%s\n' "$*" >&2; exit 1; }
say() { "${TM[@]}" display-message "  $*" 2>/dev/null || printf '%s\n' "$*"; }
# guard against a case/save/restore name walking us out of LOOT/STATE via .. —
# and against a literal ' breaking the shell command cmd_case embeds it in
# (e.g. `vi '/loot/o'brien/notes.md'` — unbalanced the moment the name has one)
no_traversal() {
  case "$1" in
    *..*) die "name may not contain '..': $1" ;;
    *\'*) die "name may not contain a single quote: $1" ;;
  esac
}

# ── vpn/iface indicator ───────────────────────────────────────────────────────
# Shows the interface I'm actually attacking from. If this is blank and I'm
# about to run something, that's the reminder I needed.
# Shows EVERY attack-relevant interface, VPN/tunnels first (that's your attacker
# IP), then the egress LAN IP dim. Screams red if no tunnel is up — a dropped VPN
# mid-exam is a silent killer. Emits tmux #[...] style codes; the status bar
# interprets them. `sensei vpn` = status readout · `sensei ip` = full popup list.
_ip_tuns() { ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^(tun|tap|wg|ppp)/ {split($4,a,"/"); print $2, a[1]}'; }
_ip_lan()  { ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(tun|tap|wg|ppp|lo|docker|br-|veth)/ {split($4,a,"/"); print $2, a[1]; exit}'; }
_ip_all()  { ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print $2, a[1]}'; }

# robust clipboard: copy to the real OS clipboard via whatever tool exists, AND
# to the tmux buffer (+OSC52) so paste works inside tmux and over SSH. Text comes
# from args ("sensei clip 10.10.14.7") or stdin (used by mouse copy-pipe).
cmd_clip() {
  local data
  if [ "$#" -gt 0 ]; then data="$*"; else data="$(cat)"; fi
  [ -n "$data" ] || return 0
  if   command -v wl-copy >/dev/null 2>&1; then printf '%s' "$data" | wl-copy >/dev/null 2>&1
  elif command -v xclip   >/dev/null 2>&1; then printf '%s' "$data" | xclip -selection clipboard >/dev/null 2>&1
  elif command -v xsel    >/dev/null 2>&1; then printf '%s' "$data" | xsel  --clipboard --input   >/dev/null 2>&1
  elif command -v pbcopy  >/dev/null 2>&1; then printf '%s' "$data" | pbcopy >/dev/null 2>&1
  fi
  printf '%s' "$data" | "${TM[@]}" load-buffer -w - >/dev/null 2>&1 || true
  local show; show=$(printf '%s' "$data" | head -c 40)
  "${TM[@]}" display-message "  copied: $show" 2>/dev/null || true
}

cmd_vpn() {
  # this runs on every status-bar redraw (status-interval, every 5s) — one `ip`
  # call shared for both the tunnel and LAN lookups instead of two, since
  # that's the whole cost of this function beyond bash's own startup.
  local raw; raw=$(ip -4 -o addr show 2>/dev/null)
  local out="" iface addr lan up=0
  while read -r iface addr; do
    [ -n "$iface" ] && { out="$out#[fg=colour107,bold]$iface #[fg=colour223]$addr#[default]  "; up=1; }
  done < <(printf '%s\n' "$raw" | awk '$2 ~ /^(tun|tap|wg|ppp)/ {split($4,a,"/"); print $2, a[1]}')
  # ACTIVE alert on the up->down transition, not just a red label that only
  # helps if you're already looking at the bar. A dropped tunnel mid-scan is
  # the "silent killer" the comment above already calls out; a passive color
  # never actually pages you. Fires once per drop, not once per redraw — and
  # never on the very first check (no VPN yet just means you haven't
  # connected, not that it dropped).
  local stf="$STATE/vpn_up" was=0
  [ -f "$stf" ] && was=$(cat "$stf" 2>/dev/null); [ -n "$was" ] || was=0
  if [ "$up" -eq 0 ] && [ "$was" = "1" ]; then
    "${TM[@]}" display-message -d 4000 "  ⚠ VPN TUNNEL DROPPED — you are off the attacker network" 2>/dev/null
  fi
  [ -d "$STATE" ] || mkdir -p "$STATE"   # builtin stat first; only forks mkdir the one time it's missing
  printf '%s' "$up" > "$stf" 2>/dev/null
  [ -z "$out" ] && out="#[fg=colour203,bold]NO-VPN#[default]  "
  # matches _ip_lan's original `ip ... scope global` pre-filter, now done in
  # awk instead since we're reusing the one shared, unfiltered `ip` snapshot
  lan=$(printf '%s\n' "$raw" | awk '/scope global/ && $2 !~ /^(tun|tap|wg|ppp|lo|docker|br-|veth)/ {split($4,a,"/"); print $2, a[1]; exit}')
  [ -n "$lan" ] && out="$out#[fg=colour244]${lan% *} ${lan#* }#[default]"
  printf '%s' "$out"
}

# full-screen readout for a popup — plain text, big, copy-friendly
cmd_ip() {
  printf '  ATTACKER INTERFACES\n\n'
  ip -4 -o addr show scope global 2>/dev/null \
    | awk '{split($4,a,"/"); printf "    %-10s %s\n", $2, a[1]}'
  local t; t=$(_ip_tuns | awk 'NR==1{print $2}')
  printf '\n'
  if [ -n "${t:-}" ]; then printf '  >> attacker IP (tun): %s\n' "$t"
  else printf '  >> (!) NO VPN INTERFACE UP\n'; fi
}

# one keystroke: copy the tunnel (attacker) IP to the OS clipboard
cmd_ipcopy() {
  local ip; ip=$(_ip_tuns | awk 'NR==1{print $2}')
  [ -n "${ip:-}" ] || { "${TM[@]}" display-message "  no VPN interface up"; return 1; }
  cmd_clip "$ip"
}

# clickable menu of every IP — click a line (or press its number) to copy that IP
cmd_ipmenu() {
  local i=1 iface addr
  local -a menu=()
  while read -r iface addr; do
    [ -n "$iface" ] || continue
    menu+=( "$iface   $addr" "$i" "run-shell 'sensei clip $addr'" )
    i=$((i+1))
  done < <(_ip_all)
  [ "${#menu[@]}" -gt 0 ] || { "${TM[@]}" display-message "  no IPs found"; return 1; }
  "${TM[@]}" display-menu -T "#[align=centre]click an IP to copy" -x C -y C "${menu[@]}"
}

# ── numbered paste-buffer picker ───────────────────────────────────────────────
# Every `y` copy (and every mouse-drag copy) already lands in a numbered tmux
# buffer — this just gives you a fast way back to one of the last few without
# `choose-buffer`'s full-screen picker. Shows a preview so you're not guessing
# which slot has what.
cmd_bufmenu() {
  local i=1 name preview key
  # quick single-key select for all 20 slots — tmux menu keys must be a single
  # keystroke, so past 9 this can't just be "10", "11"... : digits 1-9, then 0
  # for the 10th, then a-j for the 11th through 20th. Arrow keys + Enter (or a
  # click) still work on every slot regardless.
  local letters="abcdefghij"
  local -a menu=()
  while read -r name; do
    [ -n "$name" ] || continue
    preview=$("${TM[@]}" show-buffer -b "$name" 2>/dev/null | head -c 50 | tr '\n' ' ')
    # skip buffers with nothing to show (an empty selection copied by accident,
    # or all-whitespace content) — an empty numbered slot is just clutter, and
    # skipping it here (before $i advances) keeps the visible list gap-free
    case "$preview" in *[![:space:]]*) ;; *) continue ;; esac
    # display-menu item names are tmux FORMAT strings — tmux runs #(shell-command)
    # in them at render time, with no interaction needed. Buffer content is
    # whatever you copied with `y` in copy-mode, which can be scrollback from a
    # target/remote host: a hostname or filename containing "#(...)" would
    # execute on YOUR machine the instant this menu is drawn. Escape every '#'
    # to tmux's own literal-# form ('##') before it ever reaches display-menu.
    preview=${preview//#/##}
    case "$i" in
      [1-9]) key="$i" ;;
      10)    key=0 ;;
      *)     key="${letters:$((i-11)):1}" ;;
    esac
    menu+=( "$i: $preview" "$key" "paste-buffer -b $name" )
    i=$((i+1))
    [ "$i" -gt 20 ] && break   # only the 20 most recent — beyond that, choose-buffer
  done < <("${TM[@]}" list-buffers -F '#{buffer_name}' 2>/dev/null)
  [ "${#menu[@]}" -gt 0 ] || { say "no buffers yet — copy something first"; return 1; }
  "${TM[@]}" display-menu -T "#[align=centre]paste buffer" -x C -y C "${menu[@]}"
}

# ── cross-pane search ──────────────────────────────────────────────────────────
# Copy-mode's grep-layer (M-i/M-t/etc) only searches the pane you're already in.
# When you're 8 panes deep this answers "which pane had that IP/error" instead
# of you tabbing through each one by hand — greps every pane's scrollback and
# hands you a pick-list of which panes matched.
#
# Capped to the last SENSEI_FINDALL_LINES lines per pane (default 5000), not
# the full history — history-limit is 200000, and a pane that's been running
# a long burst really can hold that much. Full-history grep on every pane in
# a busy session would mean a real, felt pause every time you press F, for
# scrollback that's realistically almost always near the tail anyway. Set
# SENSEI_FINDALL_LINES=0 for the old unbounded behavior when you actually
# need to search that far back.
cmd_findall() {
  local sess="${1:?session}" pattern="${2:?pattern}"
  local lines="${SENSEI_FINDALL_LINES:-5000}"
  local -a cap=(-S -)
  [ "$lines" != "0" ] && cap=(-S "-$lines")
  local -a matches=()
  local pid count
  while read -r pid; do
    [ -n "$pid" ] || continue
    count=$("${TM[@]}" capture-pane -t "$pid" -p "${cap[@]}" -J 2>/dev/null | grep -Ec -- "$pattern" 2>/dev/null)
    [ -n "$count" ] && [ "$count" -gt 0 ] 2>/dev/null && matches+=("${pid}|${count}")
  done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}' 2>/dev/null)
  [ "${#matches[@]}" -gt 0 ] || { say "no matches for: $pattern (last $lines lines/pane — SENSEI_FINDALL_LINES=0 to search everything)"; return 1; }
  local i=1 m pid2 cnt2
  local -a menu=()
  for m in "${matches[@]}"; do
    pid2="${m%%|*}"; cnt2="${m#*|}"
    menu+=( "$pid2  ($cnt2 hits)" "$i" "select-pane -t $pid2" )
    i=$((i+1))
  done
  "${TM[@]}" display-menu -T "#[align=centre]panes matching: $pattern" -x C -y C "${menu[@]}"
}

# ── command duration for the pane border ───────────────────────────────────────
# pane_current_command tells you WHAT's running, not for how long. Paired with
# monitor-silence's "(quiet)" tag, this is the difference between "still
# working" and "probably hung" at a glance across a dozen windows. Refreshed on
# status-interval like the VPN indicator; state keyed per pane so a command
# change (new foreground process) resets the clock.
cmd_cmdtime() {
  local pane="${1:?pane_id}" cmd="${2:-}"
  local f="$STATE/cmdtime_${pane#%}" now started prevcmd
  # $EPOCHSECONDS is a bash 4.2+ builtin — no fork, unlike `date +%s`. Falls
  # back to date on macOS's stock /bin/bash (still 3.2, frozen pre-GPLv3),
  # where the builtin is unset and would otherwise silently arithmetic-evaluate
  # as 0, not fail loudly.
  now=${EPOCHSECONDS:-$(date +%s)}
  if [ -f "$f" ]; then read -r started prevcmd < "$f"; fi
  if [ -z "${started:-}" ] || [ "${prevcmd:-}" != "$cmd" ]; then
    started="$now"
    [ -d "$STATE" ] || mkdir -p "$STATE"   # builtin stat first; only forks mkdir the one time it's missing
    printf '%s %s\n' "$started" "$cmd" > "$f" 2>/dev/null
  fi
  local elapsed=$((now - started))
  if   [ "$elapsed" -lt 60 ];   then printf '%ds' "$elapsed"
  elif [ "$elapsed" -lt 3600 ]; then printf '%dm' $((elapsed / 60))
  else                               printf '%dh%02dm' $((elapsed / 3600)) $(((elapsed % 3600) / 60))
  fi
}

# ── evidence logging ──────────────────────────────────────────────────────────
sess_dir() { printf '%s/%s' "$LOOT" "$1"; }

log_arm_pane() {   # $1 session  $2 pane_id
  local d ts f
  d=$(sess_dir "$1"); mkdir -p "$d/panes"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  f="$d/panes/${ts}_${2#%}.log"
  printf '# session=%s pane=%s started=%s host=%s\n' "$1" "$2" "$ts" "$(hostname)" > "$f"
  # pipe-pane only captures output from this point forward. If logging gets
  # armed late (the whole point of Law #4 is that this shouldn't cost you
  # anything) whatever's already sitting in scrollback would otherwise just be
  # lost the moment the pane closes — so backfill it before going live.
  local backfill; backfill=$("${TM[@]}" capture-pane -t "$2" -p -S - -J 2>/dev/null)
  if [ -n "$backfill" ]; then
    printf '# --- backfilled scrollback (existed before logging was armed) ---\n' >> "$f"
    printf '%s\n' "$backfill" >> "$f"
    printf '# --- live capture begins here ---\n' >> "$f"
  fi
  "${TM[@]}" pipe-pane -t "$2" -o "cat >> '$f'"
}

cmd_log() {
  local action="${1:-status}" sess="${2:-}" pane="${3:-}"
  [ -n "$sess" ] || sess=$("${TM[@]}" display -p '#{session_name}')
  local cur; cur=$("${TM[@]}" show -t "$sess" -v @log 2>/dev/null || true)
  case "$action" in
    toggle)
      if [ -n "$cur" ]; then
        "${TM[@]}" set -t "$sess" -u @log
        while read -r p; do "${TM[@]}" pipe-pane -t "$p"; done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}')
        say "logging OFF · $sess"
      else
        "${TM[@]}" set -t "$sess" @log 1
        while read -r p; do log_arm_pane "$sess" "$p"; done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}')
        say "logging ON  · $(sess_dir "$sess")/panes"
      fi ;;
    inherit)
      # runs on EVERY new pane (after-split-window / after-new-window), logging
      # armed or not. The nested tmux call just above (show -t ... -v @log) can
      # race a just-created pane into copy-mode before its shell ever starts —
      # so the very next keys typed into it (by a human, or by `sensei burst`)
      # get read as copy-mode navigation and silently vanish instead of being
      # typed. Cancel unconditionally; it's a no-op on a pane not in a mode.
      [ -n "$pane" ] && "${TM[@]}" send-keys -t "$pane" -X cancel 2>/dev/null
      [ -n "$cur" ] && [ -n "$pane" ] && log_arm_pane "$sess" "$pane" ;;
    status)  [ -n "$cur" ] && echo on || echo off ;;
    *) die "log: toggle|inherit|status" ;;
  esac
}

# ── scrollback -> case file ───────────────────────────────────────────────────
cmd_dump() {
  local pane="${1:?pane_id}" sess="${2:-$("${TM[@]}" display -p '#{session_name}')}"
  local d f; d=$(sess_dir "$sess"); mkdir -p "$d/scrollback"
  f="$d/scrollback/$(date -u +%Y%m%dT%H%M%SZ)_${pane#%}.txt"
  "${TM[@]}" capture-pane -t "$pane" -p -S - -J > "$f"
  say "dumped $(wc -l < "$f") lines -> $f"
}

# ── notebook ──────────────────────────────────────────────────────────────────
cmd_notes() {
  local sess="${1:?session}" d; d=$(sess_dir "$sess"); mkdir -p "$d"
  [ -f "$d/notes.md" ] || {
    printf '# %s\n\nopened: %s\nscope:\n  - \n\n## findings\n\n## loose ends\n\n' \
      "$sess" "$(date -u +%F\ %TZ)" > "$d/notes.md"; }
  exec "${EDITOR:-vi}" "$d/notes.md"
}

# ── case skeleton ─────────────────────────────────────────────────────────────
# One session per target. Windows are named by phase, never auto-renamed.
cmd_case() {
  local name="${1:?case name}" d; no_traversal "$name"; d=$(sess_dir "$name")
  mkdir -p "$d"/{panes,scrollback,evidence,tools-out}
  # tmux silently replaces '.' and ':' in session names (they're target-string
  # separators) — e.g. `sensei case acme.tld`, the exact example in the README
  # and the installer's own onboarding text, actually creates a session named
  # "acme_tld". Every "=$name" target below would then fail to find it, leaving
  # a stub session with only the "recon" window and no @target set. Sanitize
  # the SESSION name only; the loot dir and @target keep the real dotted name.
  local sess; sess=$(printf '%s' "$name" | tr '.:' '__')
  if "${TM[@]}" has-session -t "=$sess" 2>/dev/null; then "${TM[@]}" switch-client -t "=$sess" 2>/dev/null; return; fi
  "${TM[@]}" new-session  -d -s "$sess" -n recon -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n fuzz   -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n shell  -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n notes  -c "$d" "${EDITOR:-vi} '$d/notes.md'"
  "${TM[@]}" set -t "=$sess:" @target "$name"    # set-option needs the trailing ':' — a bare "=$sess" fails to resolve
  "${TM[@]}" select-window -t "=$sess:recon"
  "${TM[@]}" switch-client -t "=$sess" 2>/dev/null || "${TM[@]}" attach -t "=$sess"
}

# ── burst: STAGED recon, never executed ───────────────────────────────────────
# The whole safety philosophy in one function: it types commands into panes
# and stops. I read them, I fix the scope, I press Enter myself.
#
# sensei ships no opinion about which tools you run — the chain(s) live entirely
# in burst.conf (created empty on install, never touched by updates), as one or
# more named [profile] sections, one command per line, {target} substituted in.
# Pane count is however many lines the chosen profile has — nothing is fixed.
burst_profile_names() {
  awk -F'[][]' '/^\[.+\][ \t]*$/{print $2}' "$BURST_CONF" 2>/dev/null
}
burst_profile_commands() {   # $1 = profile name
  awk -v want="$1" '
    /^\[.+\][ \t]*$/ { name=$0; gsub(/^\[|\][ \t]*$/,"",name); on=(name==want); next }
    on && NF && $0 !~ /^[ \t]*#/ { print }
  ' "$BURST_CONF" 2>/dev/null
}

cmd_burst() {
  local sess="${1:?session}" tgt="${2:-}" profile="${3:-}"
  [ -n "$tgt" ] || die "no @target set (prefix t)"
  [ -f "$BURST_CONF" ] || die "no burst profiles yet — add a [profile] section to $BURST_CONF (see README)"

  local -a profiles=()
  while IFS= read -r p; do [ -n "$p" ] && profiles+=("$p"); done < <(burst_profile_names)
  [ "${#profiles[@]}" -gt 0 ] || die "no [profile] sections found in $BURST_CONF — see README for the format"

  if [ -z "$profile" ]; then
    if [ "${#profiles[@]}" -eq 1 ]; then
      profile="${profiles[0]}"
    else
      local i=1 p; local -a menu=()
      for p in "${profiles[@]}"; do
        menu+=( "$p" "$i" "run-shell 'sensei burst \"$sess\" \"$tgt\" \"$p\"'" )
        i=$((i+1))
      done
      "${TM[@]}" display-menu -T "#[align=centre]burst profile for $tgt" -x C -y C "${menu[@]}"
      return
    fi
  fi

  local -a cmds=()
  while IFS= read -r line; do cmds+=("$line"); done < <(burst_profile_commands "$profile")
  [ "${#cmds[@]}" -gt 0 ] || die "profile '$profile' is empty or missing in $BURST_CONF"

  local safe; safe=$(printf '%s' "$tgt" | tr './:' '-')      # dots break tmux -t
  local w; w=$("${TM[@]}" new-window -P -F '#{window_id}' -t "=$sess:" -n "burst-$safe")
  local n="${#cmds[@]}" i
  for ((i = 1; i < n; i++)); do "${TM[@]}" split-window -t "$w"; done
  "${TM[@]}" select-layout -t "$w" tiled
  # collect the pane_ids in order — targeting by %id never mis-parses
  local ids; ids=$("${TM[@]}" list-panes -t "$w" -F '#{pane_id}')
  i=1
  for c in "${cmds[@]}"; do
    local rendered="${c//\{target\}/$tgt}"
    local pid; pid=$(printf '%s\n' "$ids" | sed -n "${i}p")
    if [ -n "$pid" ]; then
      # a just-split pane can land in copy-mode (e.g. the after-split-window
      # log-inherit hook races with it) — cancel any mode first or these keys
      # get read as copy-mode navigation instead of typed text and vanish
      "${TM[@]}" send-keys -t "$pid" -X cancel 2>/dev/null
      "${TM[@]}" send-keys -t "$pid" "$rendered"   # <- no Enter. Deliberate.
    fi
    i=$((i+1))
  done
  say "staged $n commands ('$profile') for $tgt — read them before you run them"
}

# ── layout persistence (no resurrect plugin) ─────────────────────────
# Fields are tab-separated (tmux emits a literal TAB in -F); window names with
# dots are fine because we target by session:index, never by name.pane. Restores geometry + cwd only —
# processes are deliberately NOT resurrected (I decide what re-runs on a target).
cmd_save() {
  local n="${1:-default}"; no_traversal "$n"; mkdir -p "$STATE"; local f="$STATE/$n.layout"; : > "$f"
  "${TM[@]}" list-panes -a -F '#{session_name}::#{window_index}::#{window_name}::#{pane_index}::#{pane_current_path}::#{window_layout}' >> "$f"
  say "saved $(wc -l < "$f") panes -> $f"
}
cmd_restore() {
  local n="${1:-default}"; no_traversal "$n"; local f="$STATE/$n.layout"; [ -f "$f" ] || die "no snapshot: $f"
  local s w wn p path lay
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    s=${line%%::*};        line=${line#*::}
    w=${line%%::*};        line=${line#*::}
    wn=${line%%::*};       line=${line#*::}
    p=${line%%::*};        line=${line#*::}
    path=${line%%::*};     line=${line#*::}
    lay=$line
    [ -n "${s:-}" ] || continue
    "${TM[@]}" has-session -t "=$s" 2>/dev/null || "${TM[@]}" new-session -d -s "$s" -n "$wn" -c "$path"
    "${TM[@]}" list-windows -t "=$s" -F '#{window_index}' | grep -qx "$w" \
      || "${TM[@]}" new-window -d -t "=$s:$w" -n "$wn" -c "$path"
    [ "$p" = "1" ] || "${TM[@]}" split-window -d -t "=$s:$w" -c "$path"
    "${TM[@]}" select-layout -t "=$s:$w" "$lay" 2>/dev/null
  done < "$f"
  say "restored $n (layout + cwd only — processes are not resurrected)"
}

# ── log hygiene ───────────────────────────────────────────────────────────────
cmd_strip() {
  local f="${1:?logfile}"
  sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\x1b\][^\x07]*\x07//g' -e 's/\r$//' "$f" \
    > "${f%.log}.clean.txt"
  say "-> ${f%.log}.clean.txt"
}

# ── one-file-per-idea experiments ───────────────────────────────────────────────
# Scaffolds a new drop-in snippet in local.d/ (see tmux-sensei.conf section 10)
# and opens it. No keybind on purpose — this is a "type it in a shell" action,
# same as setup-shell, not something you reach for mid-session.
cmd_experiment() {
  local name="${1:?experiment name}"; no_traversal "$name"
  local d="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/local.d" f
  mkdir -p "$d"
  f="$d/$name.conf"
  if [ -f "$f" ]; then
    say "already exists, opening: $f"
  else
    printf '# experiment: %s (created %s)\n# delete this file any time — nothing else depends on it. If it binds a\n# key, `unbind` it here before deleting: reload re-applies commands, it\n# does not reset state, so a stray `bind` outlives the file that added it\n# (a `set`/`setw` OPTION reverts fine on its own — this only affects binds).\n\n' \
      "$name" "$(date -u +%F)" > "$f"
    say "created $f — edit it, C-s R to try it live"
  fi
  exec "${EDITOR:-vi}" "$f"
}

# ── optional shell enhancement (NOT tmux — this touches your shell) ────────────
# Fish-style autosuggestions: type, see a greyed completion from history, press
# the right-arrow to accept. tmux can't do this (it's a shell feature), so this
# sets it up for you. bash gets prefix history-search as a fallback. Opt-in only:
# it never changes your login shell without asking.
cmd_setup_shell() {
  printf '\n  This configures your SHELL (not tmux) for live history autosuggestions.\n\n'

  # bash: look for ble.sh first — it's the real thing (per-keystroke ghost
  # text from history that updates on every letter you type, right-arrow/End
  # to accept, same feel as fish/zsh-autosuggestions). Prefix history-search
  # on up/down is only the fallback when ble.sh isn't installed — it works
  # immediately with no packages, but it's search-on-demand, not live preview.
  local br="$HOME/.bashrc"; touch "$br"
  local ble=""
  for p in \
    /usr/share/blesh/ble.sh \
    /usr/local/share/blesh/ble.sh \
    "$HOME/.local/share/blesh/ble.sh" \
    "$(brew --prefix 2>/dev/null)/share/blesh/ble.sh"
  do [ -n "$p" ] && [ -f "$p" ] && { ble="$p"; break; }; done

  if [ -n "$ble" ]; then
    if grep -qsF "$ble" "$br"; then
      say "ble.sh already wired into ~/.bashrc"
    else
      # must be the LAST line in .bashrc — ble.sh's own requirement, so it
      # can wrap whatever bash already set up (prompt, other bindings) first
      printf '\n# tmux-sensei: ble.sh — live per-keystroke ghost text (right-arrow/End to accept)\nsource %s\n' "$ble" >> "$br"
      say "ble.sh wired into ~/.bashrc (open a new bash shell to use it)"
    fi
  else
    if ! grep -qsF 'history-search-backward' "$br"; then
      {
        printf '\n# tmux-sensei: type a few letters, press up-arrow to search history by prefix\n'
        printf 'bind '"'"'"\\e[A": history-search-backward'"'"' 2>/dev/null\n'
        printf 'bind '"'"'"\\e[B": history-search-forward'"'"' 2>/dev/null\n'
      } >> "$br"
      say "bash history-search added to ~/.bashrc (prefix-search only — see below for live ghost text)"
    else
      say "bash history-search already set up (prefix-search only — see below for live ghost text)"
    fi
    printf '\n  For the real thing — live ghost text that updates as you type — install ble.sh:\n'
    printf '    git clone --recursive https://github.com/akinomyoga/ble.sh.git ~/.local/src/ble.sh\n'
    printf '    make -C ~/.local/src/ble.sh install PREFIX=~/.local\n'
    printf '  then re-run: sensei setup-shell\n\n'
  fi

  # zsh-autosuggestions: the real Fish-style ghost text
  if ! command -v zsh >/dev/null 2>&1; then
    printf '  For Fish-style ghost-text suggestions, install zsh:\n'
    printf '    sudo apt install zsh zsh-autosuggestions   (Debian/Kali/Ubuntu)\n'
    printf '    brew install zsh zsh-autosuggestions       (macOS)\n'
    printf '  then re-run: sensei setup-shell\n\n'
    return 0
  fi

  # find the plugin wherever the distro put it
  local plug=""
  for p in \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
    "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
  do [ -f "$p" ] && { plug="$p"; break; }; done

  if [ -z "$plug" ]; then
    printf '  zsh is installed but the autosuggestions plugin is not. Install it:\n'
    printf '    sudo apt install zsh-autosuggestions\n'
    printf '  or:  git clone https://github.com/zsh-users/zsh-autosuggestions ~/.zsh/zsh-autosuggestions\n'
    printf '  then re-run: sensei setup-shell\n\n'
    return 0
  fi

  local zr="$HOME/.zshrc"; touch "$zr"
  grep -qsF "$plug" "$zr" || {
    printf '\n# tmux-sensei: Fish-style history autosuggestions (right-arrow to accept)\nsource %s\n' "$plug" >> "$zr"
    say "zsh-autosuggestions wired into ~/.zshrc"
  }

  if [ "${SHELL##*/}" != "zsh" ]; then
    printf '  zsh is ready but is not your login shell.\n'
    printf '  Make it default:  chsh -s "%s"   (then log out/in)\n' "$(command -v zsh)"
    printf '  Or just try it now:  exec zsh\n\n'
  else
    printf '  Done — open a new zsh shell (or run: exec zsh). Type, then press right-arrow.\n\n'
  fi
}

# ── curated cheat sheet ────────────────────────────────────────────────────────
# tmux's own `list-keys` dumps every binding in every table, unfiltered — not
# useful as "what did I actually customize here." This is the thing install.sh
# promises ("C-s ?  (all keys)"); keep it in sync with tmux-sensei.conf's own
# `bind` lines by hand, same as the README — there's no way to generate one
# from the other without a lot more machinery than this project wants.
cmd_help() {
  cat <<'EOF'
  tmux-sensei — key map (C-s = prefix unless noted)

  PANES & WINDOWS (prefix-free, Alt)
    M-h/j/k/l    move            M-H/J/K/L   resize
    M-1..M-5     jump to window  M-o         last window
    M-z          zoom pane       M-g         scratch popup (persistent)

  NESTED / REMOTE TMUX
    C-s C-s      send a literal prefix keystroke through to it
    F12          hand the keyboard entirely to it (local tmux visibly
                 goes deaf); F12 again to take control back

  PREFIX LAYER (C-s then...)
    |  -         split vertical / horizontal     c    new window
    Q            kill pane (no confirm)          C-q  kill session (confirm)
    r            respawn pane (kill + restart)    R    reload config
    s            session/window tree
    Space        enter the sensei MODAL layer (stays until Esc — status bar
                 shows a reverse-video MODAL tag the whole time it's active)

  TARGET, EVIDENCE & STAGING
    t            set @target                     T    STAGE a burst.conf chain for @target
    C            new case skeleton                N    case-notes popup
    C-l          toggle evidence logging (session) P   dump this pane -> case file
    a  A         arm / disarm silence-watch

  ATTACKER-IP, CLIPBOARD & SEARCH
    i  I         copy tun IP / clickable IP menu   B   numbered paste-buffer picker (last 20)
    F            grep every pane's scrollback in this session

  MODES & MISC
    S            toggle synchronize-panes (loud when armed — see README)
    M            resync mouse tracking (scroll/click typing gibberish? press this)
    E  g         edit-config popup / git popup     X  C-x   open / burn the lab socket
    ?            this screen

  SENSEI MODAL LAYER (C-s Space, then...)
    h j k l      move            H J K L    resize
    o  e         main-vertical / tiled layout      x   kill pane
    m            swap pane                         Esc / q   leave

  COPY-MODE (C-s [), and its utility keys:
    /            enter copy-mode + incremental search
    ]            paste the most recent buffer       b   list every buffer (raw)
    v            select      C-v  block-select      y   copy (OSC 52, works over SSH)

  COPY-MODE grep-layer — one key each, instead of piping through grep:
    M-i IPs   M-u URLs   M-x hashes   M-t tokens/keys   M-s secrets   M-e errors

  ENV OVERRIDES (export in your shell rc, not tmux options)
    SENSEI_LOOT=<dir>          where case/evidence files land (default ~/loot)
    SENSEI_BURST_CONF=<file>   burst.conf location (default ~/.config/tmux/burst.conf)
    SENSEI_FINDALL_LINES=<n>   scrollback depth for F/findall (default 5000, 0 = unbounded)
    SENSEI_TMUX="tmux -L ..."  point the sensei script at a different socket

  Full detail: README.md. Every raw binding in every table: `tmux list-keys`
  from a shell, not this popup.
EOF
}

# ── self-update ───────────────────────────────────────────────────────────────
# Pulls the latest installer from the repo and runs it. Law #1 is "nothing
# curl|bash in the config itself" — so this downloads to a real file on disk
# FIRST (same staging discipline install.sh itself uses) instead of piping
# straight into bash, and asks before executing it. The installer then stages
# its own fetches to temp, swaps only what changed, and reloads a running
# tmux. Honors SENSEI_REPO / SENSEI_BRANCH.
cmd_update() {
  local url="https://raw.githubusercontent.com/${SENSEI_REPO}/${SENSEI_BRANCH}/install.sh"
  local dl
  if command -v curl >/dev/null 2>&1; then dl="curl -fsSL";
  elif command -v wget >/dev/null 2>&1; then dl="wget -qO-";
  else die "need curl or wget to update"; fi
  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/sensei-update.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN
  printf 'fetching install.sh from %s (%s)...\n' "$SENSEI_REPO" "$SENSEI_BRANCH"
  $dl "$url" > "$tmp" || die "fetch failed — check network and that $SENSEI_REPO is reachable"
  [ -s "$tmp" ] || die "downloaded empty install.sh — does $SENSEI_BRANCH exist?"
  printf 'staged to %s — review it before running (Law #1).\n' "$tmp"
  printf 'run it now? [y/N] '
  read -r ans
  case "$ans" in
    y|Y) SENSEI_REPO="$SENSEI_REPO" SENSEI_BRANCH="$SENSEI_BRANCH" bash "$tmp" ;;
    *)   printf 'not run. inspect it yourself: less %s && bash %s\n' "$tmp" "$tmp"
         trap - RETURN ;;
  esac
}

case "${1:-}" in
  update) cmd_update ;;
  vpn) cmd_vpn ;;
  ip) cmd_ip ;;
  ipcopy) cmd_ipcopy ;;
  ipmenu) cmd_ipmenu ;;
  bufmenu) cmd_bufmenu ;;
  findall) shift; cmd_findall "$@" ;;
  cmdtime) shift; cmd_cmdtime "$@" ;;
  clip) shift; cmd_clip "$@" ;;
  log) shift; cmd_log "$@" ;;
  dump) shift; cmd_dump "$@" ;;
  notes) shift; cmd_notes "$@" ;;
  case) shift; cmd_case "$@" ;;
  burst) shift; cmd_burst "$@" ;;
  save) shift; cmd_save "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  strip) shift; cmd_strip "$@" ;;
  setup-shell) cmd_setup_shell ;;
  experiment) shift; cmd_experiment "$@" ;;
  help) cmd_help ;;
  *) sed -n '2,20p' "$0" ;;
esac
