#!/usr/bin/env bash
# sensei — the only external dependency of tmux-sensei.conf
# One script, POSIX-ish bash, no packages. Subcommands are called from keybinds
# and hooks in the config; every one of them is safe to run by hand.
#
#   sensei vpn                      -> status-bar VPN/iface indicator
#   sensei log toggle  <session>    -> arm/disarm evidence logging for a session
#   sensei log inherit <session> <pane_id>
#   sensei dump  <pane_id> <session>-> flush scrollback to the case file
#   sensei notes <session>          -> open the case notebook
#   sensei case  <name>             -> new session skeleton for a target
#   sensei burst <session> <target> [profile] -> STAGE a chain from burst.conf (never executes)
#   sensei save [name] / restore [name]
#   sensei strip <logfile>          -> ANSI-strip a log for reporting
#   sensei bufmenu                  -> numbered paste-buffer pick-list
#   sensei findall <session> <pat>  -> grep every pane's scrollback, pick-list of hits
#   sensei cmdtime <pane_id> <cmd>  -> elapsed time for the pane border
#   sensei experiment <name>        -> scaffold + open a local.d/ drop-in snippet
#   sensei args <tool> [args so far...]  -> what comes next: subcommands, flags,
#                                    value formats — asked to the tool itself,
#                                    not a database (see ARGUMENT HELP below)
#   sensei args-popup <pane_id>     -> C-s H: same, in a popup, prefilled from
#                                    what's currently typed in that pane
#   sensei discover <tool> [sub]    -> force a fresh probe, ignoring the cache
#   sensei discover <keyword> <path> -> static-analysis-only keyword search of
#                                    a file/project directly, no PATH lookup,
#                                    no --help, nothing executed
#   sensei tools                    -> list every tool sensei has looked at so far
#   sensei complete ...             -> machine-facing: feeds real Tab-completion,
#                                    wired up by `sensei setup-shell`
#
# ── ARGUMENT HELP (sensei args / C-s H / Tab-completion) ──────────────────────
# History-based ghost text (setup-shell's ble.sh/zsh-autosuggestions) only ever
# replays what you've typed before. It has nothing to say about a tool you're
# using for the first time, or the one flag in fifty you never remember. This
# is the other half, and it's fully dynamic: no built-in tool list, nothing to
# maintain, nothing to configure. --help/-h is ONE source, not the foundation
# -- plenty of real pentest tooling is a hand-rolled wrapper script or a
# one-off with no working --help at all, so sensei ALSO reads a resolved
# tool's own source directly -- functions, aliases, getopts/case-based flag
# parsing, argparse/click calls, Makefile targets, top-level variables, the
# environment variables it actually reads (os.environ/getenv, or a bash
# $VAR it never assigns itself), and other real, on-PATH programs it shells
# out to internally (verified with an actual `command -v`, never a
# hardcoded tool list) -- never executing it, see STATIC ANALYSIS. Merges
# both sources
# into the same cache -- so it works on anything already on your $PATH,
# including a tool you wrote yourself yesterday that doesn't even respond to
# --help, the moment you use it. `sensei discover <keyword> <path>` runs the
# same static analysis directly against a file or project, no $PATH lookup
# needed at all. Four ways in:
#   - Tab, for real, in your shell — `sensei setup-shell` wires up bash's/zsh's
#     DEFAULT completer (not per-tool registration), so it applies to any
#     command with no completion of its own already.
#   - `C-s H` — popup, prefilled from what's on the command line right now.
#   - `sensei args <tool> [...]` by hand, any time.
#   - `sensei discover <keyword> <path>` — a file or project directly, for a
#     script that isn't even on $PATH yet.
# Don't remember the exact flag, just a word buried in it? Type that word
# with no dashes and no idea where it falls — "admin" finds --count-admin,
# --admin-user, --admin-only, ranked by how directly it identifies each one
# (see _keyword_rank). An exact prefix match never hides these either: typing
# "--user" still surfaces --user-agent as the primary hit AND --username /
# --create-user / --current-user right alongside it in a separate "also
# related" section (see _keyword_extra) — remembering the concept is enough,
# even when part of what you typed already matches something exactly. Works
# the same in `sensei args`, C-s H, and real Tab.
# See the ARGUMENT HELP section further down for how the parsing and caching
# actually work, and its honest limits (a hand-written, irregularly-formatted
# --help degrades to flag-names-only — still enough for Tab, just no clean
# description/value split).
set -u
TM=(${SENSEI_TMUX:-tmux})          # socket-aware: SENSEI_TMUX="tmux -L lab" for testing
LOOT="${SENSEI_LOOT:-$HOME/loot}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sensei"
BURST_CONF="${SENSEI_BURST_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/burst.conf}"
# no blanket `mkdir -p "$LOOT" "$STATE"` here on purpose — every function that
# actually writes into one already ensures its own path (log_arm_pane, dump,
# notes, case, save), and this script also runs as `sensei vpn`/`cmdtime` on
# every status-bar/pane-border refresh; forcing two mkdir stats on every one
# of those calls for directories they never touch is pure overhead.
SENSEI_REPO="${SENSEI_REPO:-sudosuraj/tmux-sensei}"
SENSEI_BRANCH="${SENSEI_BRANCH:-main}"

die() { printf '%s\n' "$*" >&2; exit 1; }
say() { "${TM[@]}" display-message "  $*" 2>/dev/null || printf '%s\n' "$*"; }
# guard against a case/save/restore name walking us out of LOOT/STATE via .. —
# and against a literal ' breaking the shell command cmd_case embeds it in
# (e.g. `vi '/loot/o'brien/notes.md'` — unbalanced the moment the name has one)
no_traversal() {
  case "$1" in
    *..*) die "name may not contain '..': $1" ;;
    *\'*) die "name may not contain a single quote: $1" ;;
  esac
}

# ── argument help: dynamic tool-grammar discovery ─────────────────────────────
# No built-in tool list, no manual reference file: sensei asks the TOOL, not a
# database curated ahead of time. `<tool> --help` (falling back to `-h`) gets
# parsed into the same tiny record format used everywhere else in this
# engine, cached per (tool, resolved-binary mtime) so the parse runs once per
# tool per install/upgrade -- not once per keystroke. Subcommand flags are
# discovered LAZILY: only the subcommand you actually type on the line gets
# probed, so a tool with a dozen subcommands doesn't cost a dozen subprocess
# calls the first time you press Tab on it.
#   T|tool|summary                              -- probed and parsed at all
#   S|tool|subcommand|summary                    -- a subcommand this tool has
#   F|tool|subcommand|flags|value|desc|enum       -- a flag (subcommand blank = global)
# `flags` is comma-joined aliases. `value` is "-" for a boolean flag, else
# whatever placeholder the tool's own help text used (<file>, string, PEM,
# ...) -- if it looks path-shaped, Tab falls back to real filename completion
# for it (see _looks_like_path/cmd_complete). `enum` is a comma list of
# actual legal values, extracted when the tool's help text spells them out as
# {a,b,c}, [a|b|c], or (a, b, c) -- empty otherwise.
#
# This trades perfect accuracy for zero maintenance and zero blind spots.
# Well-formatted --help text (most modern Go/Python CLI tools) parses into
# clean flags + values + even enumerated choices. A tool with idiosyncratic,
# hand-written help text degrades to flag-NAMES-only -- still enough for Tab
# to work, just without a clean description/value split. Worst case is no
# completion offered for a line; there is no tool this fabricates a flag for.
#
# Safety: a probe only ever runs `<tool> --help` or `<tool> -h` (or, for a
# subcommand, `<tool> <sub> --help`/`-h`) -- never through sudo, never with
# any other argument, stdin closed, output timeboxed (see _run_probe). These
# are close to universal, side-effect-free conventions, but "close to" isn't
# "guaranteed" for every binary that might be on your PATH -- exclude a
# specific tool from ever being probed with SENSEI_NO_PROBE="tool1 tool2".
SPEC_CACHE="${SENSEI_SPEC_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/tmux-sensei/toolspecs}"
PROBE_TIMEOUT="${SENSEI_PROBE_TIMEOUT:-2}"
NO_PROBE="${SENSEI_NO_PROBE:-}"

_no_probe() {  # $1=tool -> true if excluded from auto-probing
  case " ${NO_PROBE//,/ } " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }

# portable bounded-time run -- no dependency on GNU coreutils' `timeout`
# (absent on stock macOS): backgrounds the command, races a watchdog that
# kills it after PROBE_TIMEOUT seconds, and returns whatever it printed
# either way, so one hung/interactive tool costs one bounded pause, once,
# ever (the empty/partial result still gets cached -- see _ensure_top_cache).
_run_probe() {
  local out; out="$(mktemp "${TMPDIR:-/tmp}/sensei-probe.XXXXXX")" || return 1
  ( "$@" </dev/null >"$out" 2>&1 ) &
  local pid=$!
  # poll rather than a "sleep N; kill" watchdog subshell: a shell blocked
  # synchronously inside its OWN child's wait() defers an incoming SIGTERM
  # until that child (sleep) finishes on its own, so an "early" kill of a
  # two-command watchdog subshell silently waits out the full timeout anyway
  # -- a real, well-known bash trap. `wait -n` sidesteps it too but needs
  # bash 4.3+; this polls instead so it still works on macOS's stock 3.2.
  local ticks=0 max=$((PROBE_TIMEOUT * 5))
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$max" ]; then kill -TERM "$pid" 2>/dev/null; break; fi
    sleep 0.2
    ticks=$((ticks + 1))
  done
  # SIGTERM is a request, not a guarantee -- a tool that traps or ignores it
  # (or is itself stuck uninterruptibly) would otherwise hang this probe
  # indefinitely despite the "timeout" above. Give it a short grace period
  # to exit cleanly, then SIGKILL, which a process cannot trap or ignore.
  if kill -0 "$pid" 2>/dev/null; then
    local grace=0
    while [ "$grace" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
      sleep 0.2
      grace=$((grace + 1))
    done
    kill -KILL "$pid" 2>/dev/null
  fi
  wait "$pid" 2>/dev/null
  cat "$out"; rm -f "$out"
}

_probe_help() {  # $1=tool [$2=subcommand] -> raw help text on stdout
  local tool="$1" sub="${2:-}" out
  if [ -n "$sub" ]; then out="$(_run_probe "$tool" "$sub" --help)"
  else out="$(_run_probe "$tool" --help)"; fi
  if [ -z "$out" ]; then
    if [ -n "$sub" ]; then out="$(_run_probe "$tool" "$sub" -h)"
    else out="$(_run_probe "$tool" -h)"; fi
  fi
  # some tools (curl among them) print a short default help and hint at a
  # fuller one in quotes, e.g. `"--help all"` -- follow that hint once when
  # present. General convention-following, not tool-specific: it's the same
  # thing a human does after reading the short version and noticing the hint.
  local hint hints
  hints="$(printf '%s\n' "$out" | grep -oE '"-{1,2}h(elp)?[a-z-]*( [a-z]+)?"' | tr -d '"')"
  # several such hints can appear (curl's own help mentions both "--help
  # category" and "--help all") -- prefer one that says "all" (a reasonable
  # general signal for "the complete list", not just curl's convention),
  # else take the last one mentioned, usually the most-complete by convention.
  hint="$(printf '%s\n' "$hints" | grep -E '(^| )all$' | head -1)"
  [ -z "$hint" ] && hint="$(printf '%s\n' "$hints" | tail -1)"
  if [ -n "$hint" ]; then
    local fuller
    if [ -n "$sub" ]; then fuller="$(_run_probe "$tool" "$sub" $hint)"
    else fuller="$(_run_probe "$tool" $hint)"; fi
    [ -n "$fuller" ] && out="$fuller"
  fi
  printf '%s' "$out"
}

# ---- the parser: two tiers, both tested against real --help output from a
# handful of very differently-formatted tools (curl, nmap, openssl, docker,
# python3) before ever shipping. Tier 1 trusts a real column gap (2+ spaces)
# between the flag cluster and its description -- true for most GNU-getopt,
# argparse, Cobra/pflag, and optparse-generated help text. Tier 2 is the
# fallback when a line doesn't fit that shape (no gap at all, or an
# overlong flag/value that blew through the column): grab just the leading
# flag token(s) -- greedily following comma- or slash-joined aliases too, so
# "-E, --cert ..." and "-sS/sT/sA: ..." style lines still yield every alias
# -- and take the remainder of the line as description, no value/enum split.
_flags_awk_src() {
cat <<'AWKEOF'
function extract_enum(desc,    e) {
  e = ""
  if (match(desc, /\{[^}]+\}/)) {
    e = substr(desc, RSTART + 1, RLENGTH - 2)
    gsub(/[ \t]/, "", e)
  } else if (match(desc, /\[[A-Za-z0-9_|-]+\|[A-Za-z0-9_|-]+([|][A-Za-z0-9_-]+)*\]/)) {
    e = substr(desc, RSTART + 1, RLENGTH - 2)
    gsub(/\|/, ",", e)
  } else if (match(desc, /\(([A-Za-z0-9_-]+, ?){1,}[A-Za-z0-9_-]+\)/)) {
    e = substr(desc, RSTART + 1, RLENGTH - 2)
    gsub(/[ \t]/, "", e)
  }
  return e
}
# a bare numeric range as the whole value token (nmap's own "-T<0-5>:" is
# the case this exists for) is as much an enumerable closed set as a
# {choices} list -- just spelled as bounds instead of a literal list.
# Capped so a value that only LOOKS like a range (e.g. a port range someone
# wrote as 1-65535) doesn't get expanded into 65000 fake candidates.
function expand_numeric_range(tok,    b, lo, hi, i, r) {
  if (tok !~ /^[0-9][0-9]?[0-9]?-[0-9][0-9]?[0-9]?$/) return ""
  split(tok, b, "-")
  lo = b[1] + 0; hi = b[2] + 0
  if (lo >= hi || (hi - lo) > 20) return ""
  r = lo
  for (i = lo + 1; i <= hi; i++) r = r "," i
  return r
}
# a value hint that's itself a bare "A|B|C" alternation (e.g. openssl's own
# "-inform PEM|DER") is a real enum handed to us for free -- promote it. The
# "|" is always neutralized in the displayed value either way, since a
# literal "|" would otherwise corrupt this data format's own field separator.
function fold_value_into_enum(value, enumv,    v) {
  if (enumv == "" && value ~ /^<[A-Za-z0-9_-]+(\|[A-Za-z0-9_-]+)+>$/) {
    v = value
    gsub(/^<|>$/, "", v)
    enumv = v
    gsub(/\|/, ",", enumv)
  }
  gsub(/\|/, "/", value)
  return value SUBSEP enumv
}
# SRC/LOC let this SAME parser be reused on plain text that never came
# from running --help at all (see _static_analyze's "text" kind, for a
# file with no recognized shebang/extension -- some of those still embed
# a usage/options block worth reading). Unset (the real --help path,
# _write_top_cache_body/_write_sub_cache_body), source/location default to
# "help"/"<tool> [sub] --help"; set, they say so honestly, and confidence
# drops to "low" regardless of which tier matched -- a clean column split
# says the LINE is well-formed, not that this file was ever meant to be
# read as a help screen in the first place.
function emit(flags, value, desc, enumv, conf,    folded, loc, src) {
  if (flags == "") return
  folded = fold_value_into_enum(value, enumv)
  value = substr(folded, 1, index(folded, SUBSEP) - 1)
  enumv = substr(folded, index(folded, SUBSEP) + 1)
  gsub(/\|/, "/", flags); gsub(/\t/, " ", flags)
  gsub(/\|/, "/", desc); gsub(/\t/, " ", desc)
  gsub(/^[ :.\-]+/, "", desc); gsub(/[ \t]+$/, "", desc)
  gsub(/\|/, ",", enumv); gsub(/\t/, " ", enumv)
  if (LOC == "") {
    src = "help"; loc = (SUB == "") ? (TOOL " --help") : (TOOL " " SUB " --help")
  } else {
    src = SRC; loc = LOC ":" FNR; conf = "low"
  }
  printf "F|%s|%s|%s|%s|%s|%s|%s|%s|%s\n", TOOL, SUB, flags, value, desc, enumv, src, loc, conf
}
{
  line = $0
  gsub(/\r$/, "", line)
  trimmed = line
  gsub(/^[ \t]+/, "", trimmed); gsub(/[ \t]+$/, "", trimmed)
  if (trimmed == "") next
  if (substr(trimmed, 1, 1) != "-") next

  n = split(trimmed, segs, /  +/)
  head = trimmed; desc = ""
  if (n >= 2) {
    desc = segs[n]
    head = segs[1]
    for (i = 2; i < n; i++) head = head "  " segs[i]
  }

  ok = 1; flags = ""; value = "-"
  m = split(head, pieces, ",")
  for (i = 1; i <= m; i++) {
    p = pieces[i]
    gsub(/^[ \t]+/, "", p); gsub(/[ \t]+$/, "", p)
    if (p == "") continue
    if (match(p, /^--?[A-Za-z0-9][A-Za-z0-9-]*/)) {
      fl = substr(p, RSTART, RLENGTH)
      trail = substr(p, RSTART + RLENGTH)
      gsub(/^[ \t]+/, "", trail)
      flags = (flags == "" ? fl : flags "," fl)
      if (trail != "") {
        v = trail
        gsub(/^[<\[]/, "", v); gsub(/[>\]]$/, "", v)
        if (v != "") value = "<" v ">"
      }
    } else { ok = 0; break }
  }

  # trusted column gap between flag cluster and description -- clean split,
  # high confidence -- vs. tier 2 below, which grabs just the leading flag
  # token(s) with no reliable value/enum split, so it's a genuine step down.
  if (n >= 2 && ok && flags != "") { emit(flags, value, desc, extract_enum(desc), "high"); next }

  if (match(trimmed, /^--?[A-Za-z0-9]([A-Za-z0-9\/-]*[A-Za-z0-9])?/)) {
    cluster = substr(trimmed, RSTART, RLENGTH)
    rest = substr(trimmed, RSTART + RLENGTH)
    flags = ""
    m = split(cluster, parts, "/")
    for (i = 1; i <= m; i++) {
      p = parts[i]
      if (p == "") continue
      if (substr(p, 1, 1) != "-") p = "-" p
      if (p ~ /^--?[A-Za-z0-9][A-Za-z0-9-]*$/) flags = (flags == "" ? p : flags "," p)
    }

    value = "-"; enumv = ""
    # a value glued directly onto the flag with no space at all -- nmap's
    # own "-T<0-5>:" is exactly this. If it's there, it's the whole answer;
    # a real second alias is comma/slash-joined text, never bracketed, so
    # there's nothing to gain by also trying the continuation loop below.
    if (match(rest, /^[<{\[][^ \t]+[>}\]]/)) {
      vtok = substr(rest, RSTART, RLENGTH)
      rest = substr(rest, RSTART + RLENGTH)
      inner = substr(vtok, 2, length(vtok) - 2)
      value = "<" inner ">"
      enumv = extract_enum(vtok)
      if (enumv == "") enumv = expand_numeric_range(inner)
    } else {
      more = 1
      while (more) {
        more = 0
        if (match(rest, /^,[ \t]*--?[A-Za-z0-9][A-Za-z0-9-]*/)) {
          extra = substr(rest, RSTART, RLENGTH); gsub(/^,[ \t]*/, "", extra)
          flags = flags "," extra
          rest = substr(rest, RSTART + RLENGTH)
          more = 1
        } else if (match(rest, /^\/-?[A-Za-z0-9][A-Za-z0-9]*/)) {
          extra = substr(rest, RSTART, RLENGTH); sub(/^\//, "", extra)
          if (substr(extra, 1, 1) != "-") extra = "-" extra
          flags = flags "," extra
          rest = substr(rest, RSTART + RLENGTH)
          more = 1
        } else if (match(rest, /^[ \t]+[A-Za-z_][A-Za-z0-9_]*,[ \t]*--?[A-Za-z0-9][A-Za-z0-9-]*/)) {
          # argparse's own convention: "-o OUTPUT, --output OUTPUT" -- a
          # bare word directly after the flag, THEN a comma-joined alias,
          # is a repeated metavar (the value), not a second flag.
          full = substr(rest, RSTART, RLENGTH)
          if (value == "-" && match(full, /[A-Za-z_][A-Za-z0-9_]*/)) {
            value = "<" substr(full, RSTART, RLENGTH) ">"
          }
          if (match(full, /--?[A-Za-z0-9][A-Za-z0-9-]*$/)) {
            flags = flags "," substr(full, RSTART, RLENGTH)
          }
          rest = substr(rest, RSTART + RLENGTH)
          more = 1
        }
      }
    }
    gsub(/^[ \t:.,\[\]]+/, "", rest)
    gsub(/[ \t]+$/, "", rest)
    # argparse repeats the metavar after every alias ("-o OUTPUT, --output
    # OUTPUT") -- once that's captured as the value, a leftover trailing
    # copy of the exact same word is not a description, just noise.
    valinner = value; gsub(/^<|>$/, "", valinner)
    if (rest == valinner) rest = ""
    if (enumv == "") enumv = extract_enum(rest)
    if (flags != "") emit(flags, value, rest, enumv, "medium")
  }
}
AWKEOF
}

# subcommand-list detection: a literal "Commands:"/"Available Commands:"
# header with indented "name  description" lines under it (Cobra/Click), OR
# an argparse-style "{a,b,c}" brace choice-set appearing anywhere -- prints
# "name<TAB>desc" candidates, best-effort, silent (no output) if neither
# convention is used (this is exactly what a hand-written-prose tool like
# git looks like to this parser: nothing, not a wrong guess).
_subs_awk_src() {
cat <<'AWKEOF'
BEGIN { insection = 0 }
{
  line = $0
  gsub(/\r$/, "", line)
  if (line ~ /^[A-Za-z ]*[Cc]ommands:[ \t]*$/) { insection = 1; next }
  if (insection) {
    if (line ~ /^[ \t]*$/) { insection = 0; next }
    if (line !~ /^[ \t]/) { insection = 0 }
    else {
      t = line
      gsub(/^[ \t]+/, "", t)
      if (match(t, /^[A-Za-z][A-Za-z0-9_-]*\*?/)) {
        name = substr(t, RSTART, RLENGTH); gsub(/\*$/, "", name)
        rest = substr(t, RSTART + RLENGTH); gsub(/^[ \t]+/, "", rest)
        print name "\t" rest
      }
      next
    }
  }
  # a {a,b,c} brace set is only a SUBCOMMAND selector on argparse's own
  # positional-argument/usage syntax -- the exact same brace syntax also
  # shows up as an ORDINARY FLAG's value choices, e.g. a usage synopsis
  # "[--level {debug,info,warn,error}]" or the flag's own definition line
  # "--level {debug,info,warn,error}" -- and that is not a subcommand list.
  # Distinguish them by what's immediately before the brace on this line:
  # a flag-associated one is directly preceded by "-x"/"--flag" (with only
  # optional "[ " between); a genuine subcommand selector isn't (netexec's
  # own "prog [-h] {smb,winrm,...}" has a *closing* "]" in the way instead).
  if (match(line, /\{[A-Za-z0-9_,-]+,[A-Za-z0-9_,-]+\}/)) {
    pre = substr(line, 1, RSTART - 1)
    if (pre !~ /--?[A-Za-z][A-Za-z0-9_-]*[ \t]*\[?[ \t]*$/) {
      inner = substr(line, RSTART + 1, RLENGTH - 2)
      ncand = split(inner, cs, ",")
      for (i = 1; i <= ncand; i++) if (cs[i] != "") print cs[i] "\t"
      next
    }
  }

  # signal C: a dense multi-column NAME GRID with no per-item description --
  # openssl's own convention ("Standard commands" / "Cipher commands", no
  # colon, then several lines that are nothing but 2+-space-packed bare
  # identifiers). Every token on the line has to look like a name for this
  # to fire, so ordinary prose essentially never qualifies by accident.
  if (line !~ /^-/ && line ~ /^[a-z]/) {
    gridline = line
    gsub(/[ \t]+$/, "", gridline)
    ncols = split(gridline, cols, /  +/)
    if (ncols >= 2) {
      allnames = 1
      for (i = 1; i <= ncols; i++) {
        c = cols[i]; gsub(/^[ \t]+/, "", c); gsub(/[ \t]+$/, "", c)
        if (c !~ /^[a-z][a-z0-9_-]*$/) { allnames = 0; break }
      }
      if (allnames) {
        for (i = 1; i <= ncols; i++) {
          c = cols[i]; gsub(/^[ \t]+/, "", c); gsub(/[ \t]+$/, "", c)
          if (c != "") print c "\t"
        }
      }
    }
  }
}
AWKEOF
}

_parse_flags() { awk -v TOOL="$1" -v SUB="$2" -v SRC="${3:-}" -v LOC="${4:-}" "$(_flags_awk_src)"; }   # help text on stdin
_parse_subs()  { awk "$(_subs_awk_src)"; }                              # help text on stdin

# ── STATIC ANALYSIS — understanding a tool that has no usable --help ──────────
# --help/-h is a convention, not a guarantee: plenty of real pentest tooling
# is a hand-rolled wrapper script, a Python one-off, a Makefile full of
# recon targets, or something with its own non-standard help mechanism (or
# none at all). Rather than treating --help as the foundation, it's ONE
# source; this is a second, independent one that reads the tool's own
# source instead of running it, and the two get MERGED (see
# _write_top_cache_body) so a tool that has decent --help but ALSO defines
# helper functions still surfaces both, and a tool with NO --help at all
# still surfaces whatever this can read from it directly.
#
# Emits the same F/S row shapes _parse_flags/_parse_subs do, plus a new "N"
# (named-item) row for things that aren't really CLI flags but are still
# useful to search by concept -- a function, a top-level config-like
# variable, a Makefile target: "N|tool|kind|name|desc".
#
# Deliberately narrow in what it calls a "flag": static analysis can find
# names and structure, but rarely the value/enum precision a real --help
# gives for free, so it fills in value="-" (boolean-shaped) unless the
# source made a value obvious. It is honest about that, the same way the
# --help parser is honest about a hand-written, irregular help text
# degrading to flag-names-only (see the note above).
_script_kind() {  # $1=path -> sh|python|ruby|perl|powershell|make|text|binary
  local p="$1"
  case "${p##*/}" in
    Makefile|makefile|GNUmakefile) printf 'make'; return ;;
  esac
  case "$p" in
    *.mk) printf 'make'; return ;;
    *.py) printf 'python'; return ;;
    *.rb) printf 'ruby'; return ;;
    *.pl|*.pm) printf 'perl'; return ;;
    *.ps1|*.psm1) printf 'powershell'; return ;;
    *.sh|*.bash) printf 'sh'; return ;;
  esac
  # binary-vs-text FIRST, before ever reading a "line" from the file: a
  # compiled ELF/PE has no guaranteed newline for a long stretch, so
  # `head -1` on one can read a large chunk of raw binary straight into a
  # bash command substitution -- which then silently mangles embedded NUL
  # bytes and prints "ignored null byte in input" to stderr on every single
  # probe of every single real binary. Classifying first (a real pipe to
  # grep, not a variable capture, so raw bytes are never round-tripped
  # through a bash string) means a binary never reaches that read at all.
  # Reuses grep's OWN binary-detection heuristic (`-I` = treat a binary
  # match as no-match) rather than hand-rolling a NUL-byte pattern: bash's
  # $'\x00' quoting can't actually hold a NUL (it truncates to an empty
  # string), which silently turned an earlier version of this check into
  # an always-true empty-pattern match -- misclassifying every plain-text
  # script with no recognized extension or shebang as "binary".
  if ! head -c 4096 "$p" 2>/dev/null | grep -Iqm1 '' 2>/dev/null; then
    printf 'binary'; return
  fi
  local shebang; shebang="$(head -c 200 "$p" 2>/dev/null | head -1)"
  case "$shebang" in
    '#!'*bash*|'#!'*/sh|'#!'*/sh\ *|'#!'*dash*) printf 'sh'; return ;;
    '#!'*python*) printf 'python'; return ;;
    '#!'*ruby*) printf 'ruby'; return ;;
    '#!'*perl*) printf 'perl'; return ;;
    '#!'*pwsh*|'#!'*powershell*) printf 'powershell'; return ;;
  esac
  printf 'text'
}

# Two passes over the SAME file (see _static_analyze's "sh" branch passing
# the path twice): pass 1 just collects every name this script assigns
# ANYWHERE (top-level or inside a function -- `local`/`export`/`readonly`
# stripped first) so pass 2 can tell "a variable this script sets" apart
# from "a variable this script only ever READS" -- the latter is exactly
# what makes something a genuine ENVIRONMENT variable (the caller is
# expected to export it) rather than an internal one, a distinction a
# single pass couldn't make on its own. Fully quoted heredoc -- nothing
# here is bash-interpolated, it's all literal awk source, same as every
# other _analyze_*_awk/_*_awk_src function in this file.
_analyze_sh_awk() {
cat <<'AWKEOF'
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
# bash language keywords/builtins -- NOT tool names -- excluded from the
# "another program this script invokes" candidate scan below, the same way
# they're already excluded from being mistaken for anything else here.
function is_keyword(w) {
  return w in KW
}
# every discovered item, whatever kind, carries the same trailing three
# fields: WHERE this came from, WHERE in the source, and HOW reliable it
# is -- see the STATIC ANALYSIS section's note on source/location/
# confidence. A clear, unambiguous syntactic construct (getopts, a
# function/alias definition, a plain assignment) is "high"; an INFERENCE
# from shape or context alone (a case pattern that merely LOOKS like a
# flag, an env var read that's never assigned so it's presumed external,
# an invoked-command guess) is "medium" -- static analysis reading real
# code, but reading between the lines rather than a declared fact.
function emitf(armname, flags, value, desc, conf, line) {
  if (line == "") line = FNR
  printf "F|%s|%s|%s|%s|%s||static:sh|%s:%d|%s\n", TOOL, armname, flags, value, desc, FILENAME, line, conf
}
function emitn(kind, name, desc, conf, line) {
  if (line == "") line = FNR
  printf "N|%s|%s|%s|%s|static:sh|%s:%d|%s\n", TOOL, kind, name, desc, FILENAME, line, conf
}
# a flag-shaped case pattern is buffered, not emitted immediately: whether
# it takes a value lives in what happens NEXT in its own arm body (a
# `shift 2` or an assignment from $2), not in the pattern line itself, so
# emission waits until the arm's real boundary (the next `;;`, the next
# pattern, or `esac`) closes it out. Finalizing is the only place that
# writes a row for it -- called from every one of those boundaries.
function finalize_pending() {
  if (pend_active) {
    d = "option handled in this script's argument parser"
    if (pend_varname != "") d = d " (sets " pend_varname ")"
    emitf(pend_scope, pend_flags, (pend_hasvalue ? "<value>" : "-"), d, "medium", pend_line)
    pend_active = 0; pend_hasvalue = 0; pend_varname = ""
  }
  pendletter = ""
}
BEGIN {
  split("if then else elif fi for while until do done case esac function select in local declare typeset readonly export unset return exit shift break continue eval exec trap set echo printf read cd pwd test true false source wait kill type command builtin times getopts alias unalias history jobs fg bg disown suspend ulimit umask hash help", kwlist, " ")
  for (i in kwlist) KW[kwlist[i]] = 1
  # bash's OWN special/builtin variables -- not something a CALLER exports,
  # so a script reading $OPTARG (getopts' own per-option value) or $RANDOM
  # is not "this script expects an environment variable," the same
  # distinction as excluding language keywords from the invokes-scan above.
  split("OPTARG OPTIND REPLY IFS PATH HOME PWD OLDPWD SHELL USER LANG LC_ALL TERM RANDOM SECONDS LINENO BASHPID FUNCNAME BASH_SOURCE BASH_VERSION BASH_VERSINFO PPID UID EUID HOSTNAME HOSTTYPE OSTYPE MACHTYPE PS1 PS2 PS3 PS4 COLUMNS LINES", bvlist, " ")
  for (i in bvlist) BASHVAR[bvlist[i]] = 1
}
NR == FNR {
  t = trim($0)
  if (t == "" || t ~ /^#/) next
  a = t; sub(/^(local|export|readonly|declare|typeset)[ \t]+/, "", a)
  if (match(a, /^[A-Za-z_][A-Za-z0-9_]*=/)) { n = a; sub(/=.*/, "", n); assigned[n] = 1 }
  rest = t
  while (match(rest, /\$\{?[A-Za-z_][A-Za-z0-9_]*/)) {
    tok = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
    gsub(/^\$\{?/, "", tok)
    if (tok ~ /^[A-Z][A-Z0-9_]*$/ && !(tok in BASHVAR)) {
      referenced[tok] = 1
      if (!(tok in refline)) refline[tok] = FNR
    }
  }
  next
}
FNR == 1 { depth = 0; casedepth = 0; curarm = ""; pend_active = 0; pendletter = "" }
{
  t = trim($0)
  if (t == "" || t ~ /^#/) next
  isdecl = 0

  if (match(t, /^(function[ \t]+)?[A-Za-z_][A-Za-z0-9_]*\(\)/)) {
    name = substr(t, RSTART, RLENGTH)
    sub(/^function[ \t]+/, "", name); sub(/\(\)$/, "", name)
    if (name != "" && !(name in seenfn)) { seenfn[name] = 1; emitn("func", name, "function defined in this script", "high") }
    isdecl = 1
  } else if (match(t, /^function[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
    name = substr(t, RSTART, RLENGTH); sub(/^function[ \t]+/, "", name)
    if (name != "" && !(name in seenfn)) { seenfn[name] = 1; emitn("func", name, "function defined in this script", "high") }
    isdecl = 1
  }

  if (match(t, /^alias[ \t]+[A-Za-z_][A-Za-z0-9_.-]*=/)) {
    name = substr(t, RSTART, RLENGTH); sub(/^alias[ \t]+/, "", name); sub(/=$/, "", name)
    rhs = t; sub(/^alias[ \t]+[A-Za-z_][A-Za-z0-9_.-]*=/, "", rhs)
    gsub(/^['"]|['"]$/, "", rhs)
    if (length(rhs) > 60) rhs = substr(rhs, 1, 60) "..."
    if (name != "" && !(name in seenalias)) { seenalias[name] = 1; emitn("alias", name, "alias for: " rhs, "high") }
  }

  # case-statement NESTING, tracked as a real stack rather than a flat
  # counter with an ad hoc "reset scope on every ;;" rule -- the latter
  # can't tell "leaving this arm" from "leaving an INNER case nested
  # inside it for its own per-flag dispatch," and clobbers the outer
  # subcommand's scope the instant the inner case's first branch closes.
  # Entering a case pushes whatever scope was active so `esac` can restore
  # it exactly; a bare `;;` never touches scope at all now -- only a fresh
  # pattern or `esac` legitimately ends an arm.
  if (t ~ /^case[ \t].*[ \t]in$/) {
    casestack[casedepth] = curarm; casedepth++
  } else if (t == "esac" || t ~ /^esac[ \t;]/) {
    finalize_pending()
    if (casedepth > 0) casedepth--
    curarm = casestack[casedepth]
  } else if (casedepth > 0) {
    # A case arm is "PATTERN) BODY ;;" -- three tokens with no requirement
    # they land on separate lines. Rather than a second, whole-line-only
    # regex bolted on for the single-line style, this walks ONE line as a
    # sequence of those same three token kinds, in whatever order they
    # actually appear: pattern-then-`)`, a `;;` terminator, or a chunk of
    # body text in between -- so "--verify) echo ... ;;" and a pattern
    # alone on its own line are the SAME state transitions, just spread
    # across a different number of lines. Every transition (a new
    # pattern, or `;;`) finalizes whatever was pending first, exactly as
    # the multi-line path already did.
    rest = t
    while (rest != "") {
      if (match(rest, /^[-A-Za-z0-9_|]+\)/)) {
        finalize_pending()
        isdecl = 1
        patt = substr(rest, 1, RLENGTH - 1)
        rest = substr(rest, RLENGTH + 1)
        gsub(/^[ \t]+/, "", rest)
        if (patt ~ /^[A-Za-z]$/) {
          # a single bare letter -- the shape of a getopts companion arm
          # ("case "$opt" in t) ... ;; esac"). Not scored as confident on
          # its own (plenty of single-letter arms have nothing to do with
          # getopts), so it only ever enriches a getopts flag already
          # found via the real optstring, never invents a flag by itself.
          pendletter = patt
        } else {
          n = split(patt, toks, "|")
          flags = ""; bareword = ""; allflags = 1
          for (i = 1; i <= n; i++) {
            tk = trim(toks[i])
            if (tk ~ /^--?[A-Za-z][A-Za-z0-9_-]*$/) { flags = (flags == "" ? tk : flags "," tk) }
            else { allflags = 0; if (bareword == "" && tk ~ /^[A-Za-z][A-Za-z0-9_-]*$/) bareword = tk }
          }
          # a pattern where every alternative looks like a flag
          # ("-v|--verbose)") is a manual per-flag argument-parsing
          # branch, scoped to whatever subcommand arm (if any) it's
          # textually inside; a pattern that's bare words instead
          # ("scan|help)") is a SUBCOMMAND selector itself, not a flag --
          # it sets the scope for everything until the matching `esac`
          # (inherited correctly through any case nested inside it),
          # rather than being emitted as a flag of its own.
          if (allflags && flags != "") {
            key = curarm "\t" flags
            if (!(key in seenflag)) {
              seenflag[key] = 1
              pend_active = 1; pend_scope = curarm; pend_flags = flags; pend_line = FNR
            }
          } else if (bareword != "") {
            curarm = bareword
            # the arm name itself IS a subcommand this script dispatches
            # on -- without this, a script whose only content is
            # subcommand-scoped (every flag nested inside one arm or
            # another) would show nothing at the top level, since
            # there'd be no unscoped flags AND no declared subcommands
            # either -- see cmd_args's "no output at all" guard, which
            # checks both.
            if (!(bareword in seensub)) {
              seensub[bareword] = 1
              printf "S|%s|%s|subcommand handled in this script's argument parser\n", TOOL, bareword
            }
          }
        }
        continue
      }
      if (match(rest, /^;;/)) {
        finalize_pending()
        rest = substr(rest, RLENGTH + 1)
        gsub(/^[ \t]+/, "", rest)
        continue
      }
      # body text: everything up to the NEXT ;; (or the rest of the line,
      # if this arm's terminator isn't on this line at all) -- a fresh
      # pattern can only legally start once a ;; has closed the current
      # arm, so stopping at the next ;; is enough to isolate exactly this
      # arm's visible body on this line without parsing real shell syntax.
      if (match(rest, /;;/)) { bodychunk = substr(rest, 1, RSTART - 1); rest = substr(rest, RSTART) }
      else { bodychunk = rest; rest = "" }

      # evidence a PENDING flag actually consumes a following argument: a
      # `shift 2` (one shift for the flag, one for its value) is the
      # standard bash idiom; an assignment reading $2/${2} straight out
      # of the body is even more direct, and the variable it lands in is
      # real, searchable signal ("TARGET_DOMAIN" for --target-domain)
      # the bare pattern text alone could never provide.
      if (pend_active) {
        if (match(bodychunk, /shift[ \t]+2\b/)) pend_hasvalue = 1
        if (match(bodychunk, /[A-Za-z_][A-Za-z0-9_]*=[ \t]*"?\$\{?2\}?"?/)) {
          pend_hasvalue = 1
          if (pend_varname == "") {
            seg = substr(bodychunk, RSTART, RLENGTH); sub(/=.*/, "", seg); gsub(/^[ \t;]+/, "", seg)
            pend_varname = seg
          }
        }
      }
      # same idea for a getopts companion arm: `t) TARGET="$OPTARG" ;;` --
      # getopts' own optstring already says definitively whether -t takes
      # a value (a trailing ":"), so this only ever ADDS the variable
      # name to an already-known flag, never invents value-taking-ness.
      if (pendletter != "" && match(bodychunk, /[A-Za-z_][A-Za-z0-9_]*=[ \t]*"?\$\{?OPTARG\}?"?/)) {
        seg = substr(bodychunk, RSTART, RLENGTH); sub(/=.*/, "", seg); gsub(/^[ \t;]+/, "", seg)
        optvarname[curarm "\t-" pendletter] = seg
      }
      # a single-line arm's body can invoke another program too
      # ("scan) nmap -sC -sV ;;") -- the OUTER, whole-line invocation
      # scan below never sees this (isdecl is set the moment a pattern
      # is found earlier on this same line), so it's checked here
      # instead, on the chunk, using the exact same rule (not a keyword,
      # not itself being assigned, verified later via a real `command
      # -v`). A plain body-only line with no pattern on it at all
      # (isdecl still 0) is left to that outer scan, unchanged.
      if (isdecl) {
        bc = trim(bodychunk)
        if (bc != "" && match(bc, /^[A-Za-z_][A-Za-z0-9_.\/-]*/)) {
          cand = substr(bc, RSTART, RLENGTH)
          aftr = substr(bc, RLENGTH + 1, 1)
          if (aftr != "=" && !is_keyword(cand) && !(cand in seencand)) {
            seencand[cand] = 1
            printf "C|%s|%s|%s:%d|static:sh\n", TOOL, cand, FILENAME, FNR
          }
        }
      }
    }
  }

  if (match(t, /getopts[ \t]+"[^"]*"/)) {
    seg = substr(t, RSTART, RLENGTH)
    qs = seg; sub(/^getopts[ \t]+"/, "", qs); sub(/"$/, "", qs)
    i = 1
    while (i <= length(qs)) {
      c = substr(qs, i, 1)
      if (c == ":") { i++; continue }
      key = "-" c
      fullkey = curarm "\t" key
      if (!(fullkey in optseen)) {
        optseen[fullkey] = 1
        opttakesvalue[fullkey] = (substr(qs, i + 1, 1) == ":") ? 1 : 0
        optline[fullkey] = FNR
      }
      i += (substr(qs, i + 1, 1) == ":") ? 2 : 1
    }
  }

  if (depth == 0 && casedepth == 0 && match(t, /^[A-Z][A-Z0-9_]*=/)) {
    name = t; sub(/=.*/, "", name)
    if (!(name in seenvar)) { seenvar[name] = 1; emitn("var", name, "top-level variable set in this script", "high") }
  }

  # a bare leading word on an otherwise plain statement line -- not a shell
  # keyword/builtin, not itself being assigned, and not a line already
  # claimed above as a function definition or a case-pattern branch (both
  # of those also start with what LOOKS like a bare word, but "run_scan()"
  # and "scan)" are declarations, not invocations) -- a CANDIDATE for
  # "another program this script invokes." Emitted as its own "C" record;
  # _static_analyze filters these through a REAL `command -v` check (not a
  # hardcoded list) before any of them ever becomes a visible row, so this
  # stays dynamic -- only names actually installed on this system survive.
  if (!isdecl && match(t, /^[A-Za-z_][A-Za-z0-9_.\/-]*/)) {
    cand = substr(t, RSTART, RLENGTH)
    after = substr(t, RLENGTH + 1, 1)
    if (after != "=" && !is_keyword(cand) && !(cand in seencand)) {
      seencand[cand] = 1
      printf "C|%s|%s|%s:%d|static:sh\n", TOOL, cand, FILENAME, FNR
    }
  }

  tmp = t; op = gsub(/\{/, "{", tmp); cl = gsub(/\}/, "}", tmp)
  depth += op - cl
  if (depth < 0) depth = 0
}
END {
  finalize_pending()
  for (v in referenced) if (!(v in assigned)) emitn("env", v, "environment variable this script reads", "medium", refline[v])
  # getopts flags are deferred to here, not emitted inline where the
  # optstring is found: the companion `case "$opt" in t) VAR=... ;; esac`
  # that names the value's variable is textually AFTER the getopts call in
  # virtually every real script, so waiting until the whole file (well,
  # this whole pass -- see the two-file NR==FNR trick up top) has been
  # read is what lets optvarname[] actually be populated before use.
  for (fullkey in optseen) {
    tabpos = index(fullkey, "\t")
    scope = substr(fullkey, 1, tabpos - 1); k = substr(fullkey, tabpos + 1)
    d = "option parsed via getopts"
    if (fullkey in optvarname) d = d " (sets " optvarname[fullkey] ")"
    emitf(scope, k, (opttakesvalue[fullkey] ? "<value>" : "-"), d, "high", optline[fullkey])
  }
}
AWKEOF
}

_analyze_python_awk() {
cat <<'AWKEOF'
function emitf(subscope, flags, value, desc, enumv, conf) {
  printf "F|%s|%s|%s|%s|%s|%s|static:python|%s:%d|%s\n", TOOL, subscope, flags, value, desc, enumv, FILENAME, STMT_LINE, conf
}
function emitn(kind, name, desc, conf) {
  printf "N|%s|%s|%s|%s|static:python|%s:%d|%s\n", TOOL, kind, name, desc, FILENAME, STMT_LINE, conf
}
{
  # add_argument(...)/add_parser(...)/click.option(...) calls routinely
  # wrap across several physical lines (black/autopep8 do this by
  # default for anything with more than one keyword argument, including
  # the choices=[...] example this is built to handle) -- a per-PHYSICAL-
  # line scan would see the flag name on one line and choices= on a
  # completely different one and never connect them. Buffered here by
  # tracking paren balance: keep appending lines until every "(" this
  # statement opened has a matching ")", THEN treat the whole joined
  # buffer as one logical line for every check below. A normal one-line
  # statement balances immediately, so this changes nothing for the
  # common case.
  if (stmtbuf == "") stmtstart = FNR
  stmtbuf = (stmtbuf == "" ? $0 : stmtbuf " " $0)
  tmp = stmtbuf; opens = gsub(/\(/, "(", tmp)
  tmp = stmtbuf; closes = gsub(/\)/, ")", tmp)
  if (opens > closes) next
  line = stmtbuf; stmtbuf = ""; STMT_LINE = stmtstart

  # subparsers: `scan = subparsers.add_parser("scan")` -- the ASSIGNMENT
  # target (here "scan") is what every later `scan.add_argument(...)`
  # call is made on, so recording that mapping is what turns "recognize
  # the subcommand name" into "know which arguments belong to it." Works
  # the same whether add_subparsers() was given a dest= or not, since
  # this keys off add_parser() itself, not how the group was created.
  if (match(line, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*[A-Za-z_][A-Za-z0-9_]*\.add_parser\(/)) {
    lhs = line; sub(/[ \t]*=.*/, "", lhs); gsub(/^[ \t]+/, "", lhs)
    if (match(line, /add_parser\([ \t]*['"][A-Za-z0-9_-]+['"]/)) {
      seg = substr(line, RSTART, RLENGTH)
      subname = seg; sub(/^add_parser\([ \t]*['"]/, "", subname); sub(/['"]$/, "", subname)
      if (lhs != "" && subname != "") {
        parser_scope[lhs] = subname
        if (!(subname in seensub)) {
          seensub[subname] = 1
          printf "S|%s|%s|subcommand handled by this script's argument parser\n", TOOL, subname
        }
      }
    }
  }

  # click command groups: `@cli.command()` (any group INSTANCE, never the
  # `click` module itself -- that's a plain @click.command() single-command
  # script, not a group member) marks the NEXT `def name(...):` as a real
  # subcommand of that group. The `@click.option(...)` decorators in between
  # belong to that subcommand too, but its own name isn't known until the
  # `def` line is reached (Click defaults it to the function name, hyphens
  # for underscores, unless overridden by command(name="...")) -- so options
  # seen while a command decorator is pending are buffered here and only
  # turned into real, scoped F rows once the def line resolves the name,
  # mirroring the "gather evidence from the body, emit once scope is known"
  # pattern already used for shell case arms and getopts.
  if (match(line, /^[ \t]*@[A-Za-z_][A-Za-z0-9_]*\.command\(/) && line !~ /^[ \t]*@click\.command\(/) {
    click_pending = 1; click_pending_name = ""
    delete click_opt_flags; delete click_opt_value; delete click_opt_desc; delete click_opt_enum; click_opt_n = 0
    if (match(line, /name[ \t]*=[ \t]*['"][A-Za-z0-9_-]+['"]/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^name[ \t]*=[ \t]*['"]/, "", seg); sub(/['"]$/, "", seg)
      click_pending_name = seg
    }
  }

  if (match(line, /add_argument\(/) || match(line, /click\.option\(/)) {
    # which parser variable is .add_argument being called on? A known
    # subparser variable scopes this flag to that subcommand; anything
    # else (the top-level parser, or click's decorator form, which has no
    # object to call through at all) stays global, same as before.
    subscope = ""
    if (match(line, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*\.add_argument\(/)) {
      pv = line; sub(/\.add_argument.*/, "", pv); gsub(/^[ \t]+/, "", pv)
      if (pv in parser_scope) subscope = parser_scope[pv]
    }
    rest = line; flags = ""; count = 0
    while (count < 2 && match(rest, /['"]-[-A-Za-z0-9_]+['"]/)) {
      tok = substr(rest, RSTART + 1, RLENGTH - 2)
      flags = (flags == "" ? tok : flags "," tok)
      rest = substr(rest, RSTART + RLENGTH)
      count++
    }
    desc = ""
    if (match(line, /help[ \t]*=[ \t]*['"][^'"]*['"]/)) {
      seg = substr(line, RSTART, RLENGTH)
      sub(/^help[ \t]*=[ \t]*['"]/, "", seg); sub(/['"]$/, "", seg)
      desc = seg
    }
    # choices=[...] is a real enum, exactly as reliable as --help's own
    # {a,b,c} notation -- argparse enforces it at runtime, so a value NOT
    # in this list would be a real error, same confidence tier as the
    # literal flag name itself.
    enumv = ""
    if (match(line, /choices[ \t]*=[ \t]*[\[\(][^\]\)]*[\]\)]/)) {
      seg = substr(line, RSTART, RLENGTH)
      sub(/^choices[ \t]*=[ \t]*[\[\(]/, "", seg); sub(/[\]\)]$/, "", seg)
      n = split(seg, parts, ",")
      for (i = 1; i <= n; i++) {
        v = parts[i]; gsub(/^[ \t]+|[ \t]+$/, "", v); gsub(/^['"]|['"]$/, "", v)
        if (v != "") enumv = (enumv == "" ? v : enumv "," v)
      }
    # click's own idiom for the same thing is type=click.Choice([...])
    # rather than argparse's choices= keyword -- same real enum, same
    # confidence, just a different spelling this needs to recognize on
    # its own rather than falling through to the generic type= handling
    # below and reporting the literal string "click.Choice" as if it
    # were a scalar type name.
    } else if (match(line, /click\.Choice\([ \t]*[\[\(][^\]\)]*[\]\)]/)) {
      seg = substr(line, RSTART, RLENGTH)
      sub(/^click\.Choice\([ \t]*[\[\(]/, "", seg); sub(/[\]\)]$/, "", seg)
      n = split(seg, parts, ",")
      for (i = 1; i <= n; i++) {
        v = parts[i]; gsub(/^[ \t]+|[ \t]+$/, "", v); gsub(/^['"]|['"]$/, "", v)
        if (v != "") enumv = (enumv == "" ? v : enumv "," v)
      }
    }
    # action= is argparse's OWN say on whether this consumes a value --
    # store_true/store_false/store_const/count/help/version never do
    # (this is argparse's real runtime behavior, not a guess); anything
    # else, INCLUDING the unwritten default action ("store"), does. A
    # click.option has no action= at all, so it falls through to the
    # same "expects a value unless told otherwise" default -- correct
    # for click too (is_flag=True is its equivalent of store_true, and
    # that's covered by the same regex family below).
    is_bool = 0
    if (match(line, /action[ \t]*=[ \t]*['"](store_true|store_false|store_const|count|help|version)['"]/)) is_bool = 1
    if (match(line, /is_flag[ \t]*=[ \t]*True/)) is_bool = 1
    metavar = ""
    if (match(line, /metavar[ \t]*=[ \t]*['"][^'"]*['"]/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^metavar[ \t]*=[ \t]*['"]/, "", seg); sub(/['"]$/, "", seg)
      metavar = seg
    }
    typ = ""
    if (match(line, /type[ \t]*=[ \t]*[A-Za-z_][A-Za-z0-9_.]*/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^type[ \t]*=[ \t]*/, "", seg)
      typ = seg
    }
    nargs = ""
    if (match(line, /nargs[ \t]*=[ \t]*['"]?[0-9+*?]+['"]?/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^nargs[ \t]*=[ \t]*['"]?/, "", seg); gsub(/['"]$/, "", seg)
      nargs = seg
    }
    # default= is real, useful information, but it doesn't drive
    # completion the way value/enum do (nothing about Tab-completion or
    # "does this take a value" changes based on it) -- so unlike those,
    # it's surfaced in the description rather than earning its own
    # structured field, the same tradeoff already made for a getopts
    # flag's inferred variable name.
    defaultv = ""
    if (match(line, /default[ \t]*=[ \t]*['"][^'"]*['"]/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^default[ \t]*=[ \t]*['"]/, "", seg); sub(/['"]$/, "", seg)
      defaultv = seg
    } else if (match(line, /default[ \t]*=[ \t]*[A-Za-z0-9_.]+/)) {
      seg = substr(line, RSTART, RLENGTH); sub(/^default[ \t]*=[ \t]*/, "", seg)
      if (seg != "None") defaultv = seg
    }

    if (is_bool) { val = "-" }
    else if (enumv != "") { val = "<value>" }
    else if (metavar != "") { val = "<" metavar ">" }
    else if (typ != "") { val = "<" typ ">" }
    else { val = "<value>" }
    if (!is_bool && (nargs == "+" || nargs == "*")) val = val "..."

    d = (desc == "" ? "argument parsed by this script" : desc)
    if (defaultv != "") d = d " (default: " defaultv ")"

    if (click_pending) {
      if (flags != "") {
        click_opt_n++
        click_opt_flags[click_opt_n] = flags
        click_opt_value[click_opt_n] = val
        click_opt_desc[click_opt_n] = d
        click_opt_enum[click_opt_n] = enumv
      }
    } else {
      key = subscope "\t" flags
      if (flags != "" && !(key in seenflag)) {
        seenflag[key] = 1
        emitf(subscope, flags, val, d, enumv, "high")
      }
    }
  }
  if (match(line, /^def[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)) {
    name = line; sub(/^def[ \t]+/, "", name); sub(/[ \t]*\(.*/, "", name)
    if (click_pending) {
      if (click_pending_name != "") { subname = click_pending_name }
      else { subname = name; gsub(/_/, "-", subname) }
      if (subname != "" && !(subname in seensub)) {
        seensub[subname] = 1
        printf "S|%s|%s|subcommand handled by this script's Click command group\n", TOOL, subname
      }
      for (ci = 1; ci <= click_opt_n; ci++) {
        key = subname "\t" click_opt_flags[ci]
        if (!(key in seenflag)) {
          seenflag[key] = 1
          emitf(subname, click_opt_flags[ci], click_opt_value[ci], click_opt_desc[ci], click_opt_enum[ci], "high")
        }
      }
      click_pending = 0; click_opt_n = 0
    }
    if (name != "" && substr(name, 1, 1) != "_" && !(name in seenfn)) {
      seenfn[name] = 1; emitn("func", name, "function defined in this script", "high")
    }
  }

  # environment variables this script actually reads -- os.environ[...]/
  # .get(...) and os.getenv(...) are the two conventional ways. Unlike the
  # shell side, this isn't a two-pass "referenced but never assigned"
  # inference -- reading via one of these calls IS the declaration that
  # it's an environment variable, so this is as reliable as it gets short
  # of a real interpreter; still "medium" rather than "high" because
  # nothing here confirms this line actually executes (e.g. dead code, or
  # feature-flagged off) the way a literal argparse flag name would.
  if (match(line, /os\.environ\[['"][A-Za-z_][A-Za-z0-9_]*['"]\]/) ||
      match(line, /os\.environ\.get\(['"][A-Za-z_][A-Za-z0-9_]*['"]/) ||
      match(line, /os\.getenv\(['"][A-Za-z_][A-Za-z0-9_]*['"]/)) {
    name = substr(line, RSTART, RLENGTH)
    sub(/^[^'"]*['"]/, "", name); sub(/['"].*$/, "", name)
    if (name != "" && !(name in seenenv)) { seenenv[name] = 1; emitn("env", name, "environment variable this script reads", "medium") }
  }

  # another program this script shells out to -- subprocess.*(...) with a
  # literal command name, or os.system("cmd ..."). Emitted as a "C"
  # candidate, same as the shell analyzer's, and filtered the same way by
  # _static_analyze (a real `command -v` check, not a hardcoded list).
  if (match(line, /subprocess\.(run|call|Popen|check_call|check_output)\(/)) {
    rest = substr(line, RSTART + RLENGTH)
    if (match(rest, /['"][-A-Za-z0-9_.\/]+['"]/)) {
      cmd = substr(rest, RSTART + 1, RLENGTH - 2)
      if (cmd != "" && !(cmd in seencand)) { seencand[cmd] = 1; printf "C|%s|%s|%s:%d|static:python\n", TOOL, cmd, FILENAME, STMT_LINE }
    }
  } else if (match(line, /os\.system\(['"]/)) {
    rest = line; sub(/^.*os\.system\(['"]/, "", rest)
    if (match(rest, /^[-A-Za-z0-9_.\/]+/)) {
      cmd = substr(rest, RSTART, RLENGTH)
      if (cmd != "" && !(cmd in seencand)) { seencand[cmd] = 1; printf "C|%s|%s|%s:%d|static:python\n", TOOL, cmd, FILENAME, STMT_LINE }
    }
  }
}
AWKEOF
}

_analyze_make_awk() {
cat <<'AWKEOF'
function emitn(kind, name, desc) {
  printf "N|%s|%s|%s|%s|static:make|%s:%d|high\n", TOOL, kind, name, desc, FILENAME, FNR
}
{
  line = $0
  if (line ~ /^\t/) next
  if (line ~ /^\./) next
  if (match(line, /^[A-Za-z0-9_.%\/-]+[ \t]*:([^=]|$)/)) {
    tgt = line; sub(/:.*/, "", tgt); gsub(/[ \t]+$/, "", tgt)
    if (tgt != "" && !(tgt in seentgt)) { seentgt[tgt] = 1; emitn("target", tgt, "Makefile target") }
  } else if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*[:+?]?=/)) {
    v = line; sub(/[ \t]*[:+?]?=.*/, "", v)
    if (v != "" && !(v in seenvar)) { seenvar[v] = 1; emitn("var", v, "Makefile variable") }
  }
}
AWKEOF
}

# ruby/perl/powershell share one lighter-weight pass -- function/sub defs
# only. Their own flag-parsing conventions (OptionParser, Getopt::Long,
# param() blocks) are real but varied enough that a shallow regex risks
# more false positives than it's worth; function names alone still make
# `tool <concept><Tab>` find something real instead of nothing, which is
# the honest, narrower win this makes for these three.
_analyze_misc_awk() {
cat <<'AWKEOF'
{
  line = $0
  if (KIND == "ruby" && match(line, /^def[ \t]+[A-Za-z_][A-Za-z0-9_?!]*/)) {
    name = substr(line, RSTART, RLENGTH); sub(/^def[ \t]+/, "", name)
  } else if (KIND == "perl" && match(line, /^sub[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
    name = substr(line, RSTART, RLENGTH); sub(/^sub[ \t]+/, "", name)
  } else if (KIND == "powershell" && match(line, /^function[ \t]+[A-Za-z_][A-Za-z0-9_-]*/)) {
    name = substr(line, RSTART, RLENGTH); sub(/^function[ \t]+/, "", name)
  } else { name = "" }
  if (name != "" && !(name in seenfn)) {
    seenfn[name] = 1
    printf "N|%s|func|%s|function/sub defined in this script|static:%s|%s:%d|high\n", TOOL, name, KIND, FILENAME, FNR
  }
}
AWKEOF
}

# a raw "C|tool|name" candidate (see _analyze_sh_awk/_analyze_python_awk)
# means "this line looked like it invokes something named NAME" -- turned
# into a real, visible "N|invokes" row only if NAME is an ACTUAL program
# on this system ($PATH, checked here, once, for real -- never a hardcoded
# list of tool names). A candidate that's really a call to a function the
# same script defines (the overwhelmingly common false-positive: a case
# branch or plain statement just invoking a helper) simply won't resolve
# and gets silently dropped, no different from --help parsing silently
# finding nothing on a line it can't make sense of.
_filter_invoked_candidates() {  # rows on stdin ("C|tool|name|location|source") -> same rows, C -> verified N|invokes or dropped
  local line tool name loc src
  while IFS= read -r line; do
    case "$line" in
      C\|*)
        IFS='|' read -r _ tool name loc src <<<"$line"
        command -v "$name" >/dev/null 2>&1 &&
          printf 'N|%s|invokes|%s|tool invoked by this script|%s|%s|medium\n' "$tool" "$name" "$src" "$loc"
        ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

_static_analyze() {  # $1=tool $2=path $3=kind -> N/F/S rows on stdout
  local tool="$1" path="$2" kind="$3"
  case "$kind" in
    sh)         awk -v TOOL="$tool" "$(_analyze_sh_awk)" "$path" "$path" 2>/dev/null | _filter_invoked_candidates ;;
    python)     awk -v TOOL="$tool" "$(_analyze_python_awk)" "$path" 2>/dev/null | _filter_invoked_candidates ;;
    make)       awk -v TOOL="$tool" "$(_analyze_make_awk)" "$path" 2>/dev/null ;;
    ruby|perl|powershell)
                awk -v TOOL="$tool" -v KIND="$kind" "$(_analyze_misc_awk)" "$path" 2>/dev/null ;;
    text)       _parse_flags "$tool" "" "static:text" "$path" < "$path" 2>/dev/null ;;
    *) : ;;
  esac
}

# best-effort one-line summary straight from the source when --help gave
# nothing to work with: a Python module docstring, or the first real
# top-of-file comment (after any shebang) for everything else.
_static_summary() {  # $1=path $2=kind
  local path="$1" kind="$2"
  case "$kind" in
    python)
      awk '
        NR <= 60 {
          if (!started) { if ($0 ~ /^"""/) { started = 1; rest = $0; sub(/^"""/, "", rest); sub(/"""[ \t]*$/, "", rest); if (rest != "") { print rest; exit } }; next }
          line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line)
          if (line != "") { print line; exit }
        }
      ' "$path" 2>/dev/null ;;
    sh|ruby|perl|make)
      awk '
        NR == 1 && /^#!/ { next }
        /^[ \t]*#/ { line = $0; sub(/^[ \t]*#[ \t]*/, "", line); if (line != "") { print line; exit }; next }
        /^[ \t]*$/ { next }
        { exit }
      ' "$path" 2>/dev/null ;;
  esac
}

# a stable, filesystem-safe cache key for a resolved binary -- basename plus
# a short checksum (cksum, POSIX, no new dependency) of the full path, so two
# different binaries sharing a basename (a project-local ./nmap wrapper vs
# /usr/bin/nmap) never collide.
_cache_key() {
  local base="${1##*/}" h
  h="$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
  printf '%s_%s' "$base" "$h"
}

# shared cache-write shell: check the mtime-stamp header, and if stale/
# missing, write via a unique temp name (not a fixed "$f.tmp") -- two sensei
# invocations racing to discover the same not-yet-cached tool at once (two
# panes, or a shell and the C-s H popup) would otherwise open and write the
# same path independently, and whichever `mv` lands last could publish a
# torn/interleaved file for the other to read mid-write -- then atomically
# publish it. $3 (a function name) is called with the remaining args to
# produce the body; only WHAT gets probed/parsed differs between callers.
_ensure_cache_generic() {  # $1=file $2=mtime $3=writer-fn [writer-args...]
  local f="$1" mt="$2" writer="$3"; shift 3
  if [ -f "$f" ] && [ "$(head -1 "$f" 2>/dev/null)" = "# mtime:$mt" ]; then
    printf '%s' "$f"; return 0
  fi
  mkdir -p "$SPEC_CACHE"
  local tmp; tmp="$(mktemp "${f}.XXXXXX")" || return 1
  { printf '# mtime:%s\n' "$mt"; "$writer" "$@"; } > "$tmp" && mv "$tmp" "$f"
  printf '%s' "$f"
}

# drop a static-analysis F row when ANY of its comma-joined alias names is
# already covered by a help-derived F row -- help wins on description/value
# quality when both sources found the same flag, static analysis only adds
# what help DIDN'T already say. N/S rows from static analysis pass through
# untouched; there's nothing in a --help parse to collide with there.
_merge_static_rows() {  # $1=help-derived rows $2=static rows
  awk -F'|' '
    NR == FNR { if ($1 == "F") { n = split($4, a, ","); for (i = 1; i <= n; i++) seen[a[i]] = 1 }; print; next }
    $1 == "F" { n = split($4, a, ","); dup = 0; for (i = 1; i <= n; i++) if (a[i] in seen) dup = 1; if (dup) next }
    { print }
  ' <(printf '%s\n' "$1") <(printf '%s\n' "$2")
}

# A tool doesn't have to say NOTHING for --help to be useless -- a
# getopts-style script with no --help/-h case of its own prints its OWN
# ARGUMENT-PARSING ERROR instead ("wraptool: illegal option -- -"), and an
# interpreted script that fails to even start (missing dependency, syntax
# error, wrong interpreter version) prints a crash, not documentation.
# Either way that's real, non-empty output -- so without this check it
# would win as the tool's one-line summary, or get run through the flag
# parser as if it were real help text, over a much better answer static
# analysis can give directly from the source. Failure output is not tool
# documentation, in whatever language produced it; the patterns below
# span the shell/getopts case this started from plus the interpreter
# crash signatures of the languages the static analyzer itself
# understands (Python, Ruby, Perl), not an attempt at exhaustive coverage
# of every possible runtime on a PATH.
_looks_like_help_error() {
  case "$1" in
    *"illegal option"*|*"invalid option"*|*"unrecognized option"*|*"unknown option"*|*"option requires an argument"*|*": command not found"*) return 0 ;;
    *"Traceback (most recent call last)"*|*"ModuleNotFoundError"*|*"ImportError:"*|*"SyntaxError:"*|*"IndentationError:"*|*"NameError:"*|*"AttributeError:"*) return 0 ;;
    *"LoadError"*|*"NoMethodError"*|*".rb:"*": in "*|*"uninitialized constant"*) return 0 ;;
    *"Can't locate"*|*"syntax error at"*"line"*) return 0 ;;
    *"Segmentation fault"*|*"core dumped"*|*"cannot execute binary file"*|*"No such file or directory"*|*"Permission denied"*) return 0 ;;
    *) return 1 ;;
  esac
}

_write_top_cache_body() {  # $1=tool
  local tool="$1"
  if _no_probe "$tool"; then
    printf 'T|%s|(SENSEI_NO_PROBE excludes this tool from auto-discovery)\n' "$tool"
    return
  fi

  # --help/-h is ONE source, not the foundation: it's the only source that
  # runs the tool at all (bounded, stdin closed, no other args -- see
  # _run_probe/_probe_help), and plenty of real pentest tooling either
  # doesn't support it or barely says anything useful through it. Static
  # analysis of the resolved binary's own text is a second, independent,
  # NEVER-executes source that works whether or not --help does -- see the
  # STATIC ANALYSIS section above. Both get gathered and merged below,
  # rather than static analysis only ever being a fallback for when help
  # comes back empty.
  local bin kind=""
  bin="$(command -v "$tool" 2>/dev/null)"
  [ -n "$bin" ] && [ -f "$bin" ] && [ -r "$bin" ] && kind="$(_script_kind "$bin")"

  local help; help="$(_probe_help "$tool")"

  local static=""
  case "$kind" in
    sh|python|ruby|perl|powershell|make|text) static="$(_static_analyze "$tool" "$bin" "$kind")" ;;
  esac

  # decided once, used twice: a summary line pulled from a crash is
  # useless, but running the FLAG PARSER over a crash's raw text is worse
  # than useless -- it's guessing structure out of noise. Either way, the
  # honest move is to fall back to static analysis rather than pretend the
  # failed probe said something real.
  local help_ok=1
  [ -n "$help" ] && _looks_like_help_error "$help" && help_ok=0

  local summary=""
  [ -n "$help" ] && [ "$help_ok" -eq 1 ] && summary="$(printf '%s\n' "$help" | awk 'NF{print; exit}' | cut -c1-100 | tr '|' '/')"
  [ -z "$summary" ] && [ -n "$kind" ] && summary="$(_static_summary "$bin" "$kind" | cut -c1-100 | tr '|' '/')"
  printf 'T|%s|%s\n' "$tool" "${summary:-$tool}"

  local helprows=""
  if [ -n "$help" ] && [ "$help_ok" -eq 1 ]; then
    helprows="$(printf '%s\n' "$help" | _parse_flags "$tool" ""
      printf '%s\n' "$help" | _parse_subs | awk -F'\t' -v t="$tool" '
        { n=$1; d=$2; gsub(/\|/,"/",n); gsub(/\|/,"/",d); gsub(/\t/," ",d); print "S|" t "|" n "|" d }')"
  fi
  if [ -n "$helprows" ] && [ -n "$static" ]; then
    _merge_static_rows "$helprows" "$static"
  elif [ -n "$helprows" ]; then
    printf '%s\n' "$helprows"
  elif [ -n "$static" ]; then
    printf '%s\n' "$static"
  fi
}

_write_sub_cache_body() {  # $1=tool $2=sub
  local tool="$1" sub="$2"
  if ! _no_probe "$tool"; then
    local help; help="$(_probe_help "$tool" "$sub")"
    if [ -n "$help" ] && ! _looks_like_help_error "$help"; then
      printf '%s\n' "$help" | _parse_flags "$tool" "$sub"
    fi
  fi
  # "nothing found" is a valid, cacheable outcome (a tool with no working
  # `<tool> <sub> --help` at all -- its static-analysis-derived, sub-
  # scoped flags already live in the TOP cache instead, see
  # _analyze_sh_awk's case-arm scoping), not a failure -- without this, the
  # bare `[ -n "$help" ] && ...` above being false makes THIS function
  # return 1, which _ensure_cache_generic's `{ ... } && mv` then reads as
  # "the write failed," silently skipping the mv and leaving the cache
  # file never created at all.
  return 0
}

_ensure_top_cache() {  # $1=tool -> prints the cache FILE PATH
  local tool="$1"
  local bin; bin="$(command -v "$tool" 2>/dev/null)" || return 1
  local key; key="$(_cache_key "$bin")"
  local f="$SPEC_CACHE/${key}.top"
  local mt; mt="$(_mtime "$bin")"
  _ensure_cache_generic "$f" "$mt" _write_top_cache_body "$tool"
}

_ensure_sub_cache() {  # $1=tool $2=sub -> prints the cache FILE PATH
  local tool="$1" sub="$2"
  local bin; bin="$(command -v "$tool" 2>/dev/null)" || return 1
  local key; key="$(_cache_key "$bin")"
  local safesub; safesub="$(printf '%s' "$sub" | tr -c 'A-Za-z0-9_-' '_')"
  local f="$SPEC_CACHE/${key}__${safesub}.sub"
  local mt; mt="$(_mtime "$bin")"
  _ensure_cache_generic "$f" "$mt" _write_sub_cache_body "$tool" "$sub"
}

# the merged view for tool[/sub]: top-level (summary + global flags +
# known subcommand names) always; that ONE subcommand's own flags too, but
# only when asked for -- this is what keeps discovery lazy.
#
# Memoized for the life of this one sensei process: a single `cmd_args`/
# `cmd_complete` call queries this same (tool, sub) pair repeatedly (once
# per already-typed word to find the chosen subcommand, again for its flag
# value, again to list flags/subcommands) -- without this, each of those
# re-resolves the binary path, re-stats its mtime, and re-`cat`s the same
# on-disk cache file from scratch. One process only ever needs one blob.
_SPEC_BLOB_KEY=""
_SPEC_BLOB_VAL=""
_spec_blob_for() {  # $1=tool $2=sub(may be empty)
  local tool="$1" sub="$2" key="$1|$2"
  if [ "$key" = "$_SPEC_BLOB_KEY" ]; then
    printf '%s' "$_SPEC_BLOB_VAL"
    return 0
  fi
  local f; f="$(_ensure_top_cache "$tool")" || return 1
  local blob=""
  [ -n "$f" ] && blob="$(cat "$f")"
  if [ -n "$sub" ]; then
    local sf; sf="$(_ensure_sub_cache "$tool" "$sub")"
    [ -n "$sf" ] && blob="${blob}
$(cat "$sf")"
  fi
  _SPEC_BLOB_KEY="$key"
  _SPEC_BLOB_VAL="$blob"
  printf '%s' "$blob"
}

_spec_have_tool() { command -v "$1" >/dev/null 2>&1; }
_spec_is_sub() {      # $1=tool $2=word
  _spec_blob_for "$1" "" | awk -F'|' -v s="$2" '$1=="S" && $3==s {f=1} END{exit !f}'
}
_spec_tool_summary() { _spec_blob_for "$1" "" | awk -F'|' '$1=="T"{print $3; exit}'; }
_spec_subs() { _spec_blob_for "$1" "" | awk -F'|' '$1=="S"{print $3"\t"$4}'; }
# "alias<TAB>value<TAB>desc<TAB>enum<TAB>source<TAB>location<TAB>confidence"
# -- every consumer that only needs the first 3-4 fields (the compact
# table, prefix/keyword matching) keeps working untouched; the trailing
# three are there for a caller that wants to show WHERE a specific
# discovered item came from and how sure sensei is about it (see cmd_args'
# single-flag detail view).
# $3 (the row's own SUB field) must match what was actually asked for --
# global (empty) or this exact subcommand -- never just "every F row in
# the blob." --help-derived rows never needed this: a subcommand's flags
# only ever enter the blob at all when _spec_blob_for merges in that ONE
# subcommand's own cache file. Static analysis writes every scope it finds
# into the SAME top-level cache file, tagging each row's scope as data
# instead of as a separate file -- so without this filter, a flag only
# ever valid under one arm of a script's own dispatch would leak into the
# global suggestion list, and into every OTHER subcommand's list too.
_spec_flags_expanded() {  # $1=tool $2=sub(may be empty)
  _spec_blob_for "$1" "$2" | awk -F'|' -v want="$2" '
    $1=="F" && ($3=="" || $3==want) { n = split($4, a, ","); for (i = 1; i <= n; i++) print a[i]"\t"$5"\t"$6"\t"$7"\t"$8"\t"$9"\t"$10 }'
}
_spec_flag_value() {  # $1=tool $2=sub $3=flag -> "value<TAB>enum" if $3 is a known value-taking flag
  _spec_blob_for "$1" "$2" | awk -F'|' -v f="$3" -v want="$2" '
    $1=="F" && ($3=="" || $3==want) { n = split($4, a, ","); for (i = 1; i <= n; i++) if (a[i] == f) { print $5"\t"$7; exit } }'
}
# static-analysis-derived variables/targets/env-refs/invoked-tools -- see
# the STATIC ANALYSIS section. Shaped IDENTICALLY to _spec_flags_expanded's
# 7 tab fields (value always "-", enum always empty) so callers can
# concatenate the two and feed both through the exact same prefix/keyword
# matching and the exact same flags table, with no separate code path to
# keep in sync -- one unified row shape, regardless of which underlying
# record kind (F or N) it came from.
#
# "func" and "alias" are deliberately excluded here: a function or shell
# alias defined INSIDE a script is never itself a token you'd type as one
# of ITS arguments (the confusion is worst with Click, whose handler
# function names routinely match the subcommand name exactly -- listing
# "scan (func)" as a candidate right next to the real "scan" subcommand is
# noise, not a suggestion). They're still real, useful facts about a
# script's structure, so cmd_discover_path's keyword search (which exists
# precisely to answer "does this file relate to X" from source, not "what
# can I type next") surfaces them via _static_rows_unified, unfiltered.
_spec_named() {  # $1=tool $2=sub(may be empty)
  _spec_blob_for "$1" "$2" | awk -F'|' '$1=="N" && $3!="func" && $3!="alias" {printf "%s\t-\t%s (%s)\t\t%s\t%s\t%s\n", $4, $5, $3, $6, $7, $8}'
}

# two shapes share this one entry point, disambiguated by whether the
# second argument is an existing path (a subcommand name essentially never
# is): `sensei discover <tool> [sub]` force-reprobes a cached tool via
# --help as before; `sensei discover <keyword> <path>` inspects a file or
# project DIRECTLY, by static analysis only, with no PATH lookup and no
# --help involved at all -- for a script that isn't even executable yet,
# isn't on $PATH, or that you just want to search without caching it.
cmd_discover() {  # sensei discover <tool> [sub]  OR  sensei discover <keyword> <path>
  local a1="${1:?usage: sensei discover <tool> [sub]   OR   sensei discover <keyword> <path>}" a2="${2:-}"
  if [ -n "$a2" ] && [ -e "$a2" ]; then
    cmd_discover_path "$a1" "$a2"
    return
  fi
  local tool="$a1" sub="$a2"
  _spec_have_tool "$tool" || die "not found on PATH: $tool"
  rm -f "$SPEC_CACHE/$(_cache_key "$(command -v "$tool")")"*
  _ensure_top_cache "$tool" >/dev/null
  [ -n "$sub" ] && _ensure_sub_cache "$tool" "$sub" >/dev/null
  say "re-discovered $tool${sub:+ $sub}"
}

# static-analysis-only keyword search over a file or a shallow project
# walk -- never touches $PATH, never runs anything, no cache written (this
# is for an ad-hoc "does this thing have anything to do with X" look, not
# the repeated per-keystroke lookups Tab-completion needs caching for).
# converts raw F/N analyzer rows into the SAME unified 7-tab-field shape
# _spec_flags_expanded/_spec_named produce for a cached, on-PATH tool --
# any scope, since an ad-hoc "does this file have anything to do with X"
# search has no "current subcommand" context to narrow by the way
# cmd_args/cmd_complete do. This is the one place that duplicates that
# field mapping (rather than sharing it outright with _spec_flags_expanded/
# _spec_named, which DO need the scope-aware filter) -- but the ranking
# itself does NOT get re-implemented here: see cmd_discover_path below,
# which feeds this straight into _match_with_related, the exact same
# matcher `sensei args` and real Tab-completion use.
_static_rows_unified() {  # raw F/N rows on stdin
  awk -F'|' '
    $1=="F" { n = split($4, a, ","); for (i = 1; i <= n; i++) print a[i]"\t"$5"\t"$6"\t"$7"\t"$8"\t"$9"\t"$10 }
    $1=="N" { printf "%s\t-\t%s (%s)\t\t%s\t%s\t%s\n", $4, $5, $3, $6, $7, $8 }
  '
}

cmd_discover_path() {  # $1=keyword $2=file-or-dir
  local kw="$1" path="$2"
  local -a files=()
  if [ -d "$path" ]; then
    while IFS= read -r f; do files+=("$f"); done < <(
      find "$path" -maxdepth 3 \
        \( -name .git -o -name node_modules -o -name .venv -o -name venv \) -prune -o \
        -type f \( -name '*.sh' -o -name '*.bash' -o -name '*.py' -o -name '*.rb' \
                   -o -name '*.pl' -o -name '*.pm' -o -name '*.ps1' -o -name '*.psm1' \
                   -o -name 'Makefile' -o -name 'makefile' -o -name 'GNUmakefile' -o -name '*.mk' \
                   -o -perm -u+x \) -print 2>/dev/null
    )
  elif [ -f "$path" ]; then
    files=("$path")
  else
    die "not a file or directory: $path"
  fi
  [ "${#files[@]}" -gt 0 ] || { say "nothing inspectable found under $path"; return 0; }

  local any=0 f kind raw rows
  for f in "${files[@]}"; do
    [ -r "$f" ] || continue
    kind="$(_script_kind "$f")"
    case "$kind" in sh|python|ruby|perl|powershell|make|text) : ;; *) continue ;; esac
    raw="$(_static_analyze "${f##*/}" "$f" "$kind")"
    [ -n "$raw" ] || continue
    rows="$(printf '%s\n' "$raw" | _static_rows_unified)"
    [ -n "$rows" ] || continue
    # same policy, same function, same output shape as cmd_args' flags
    # section: exact match primary, conceptually-related supplement --
    # NOT a separate ranking implementation for this entry point.
    _match_with_related "$rows" "$kw" 3
    if [ -n "$MWR_PRIMARY" ] || [ -n "$MWR_EXTRA" ]; then
      any=1
      printf '  %s:\n' "$f"
      if [ -n "$MWR_PRIMARY" ]; then
        printf '%s\n' "$MWR_PRIMARY" | awk -F'\t' '{
          v = ($2 == "-") ? "" : $2
          printf "    %-20s %-14s %s\n", $1, v, $3
        }'
      fi
      if [ -n "$MWR_EXTRA" ]; then
        printf '    also related to "%s":\n' "$kw"
        printf '%s\n' "$MWR_EXTRA" | awk -F'\t' '{
          v = ($2 == "-") ? "" : $2
          printf "      %-18s %-14s %s\n", $1, v, $3
        }'
      fi
    fi
  done
  [ "$any" -eq 1 ] || say "nothing matching \"$kw\" found under $path"
}

cmd_tools() {  # sensei tools -- what sensei has already discovered
  [ -d "$SPEC_CACHE" ] || { say "nothing discovered yet — Tab-complete or run \`sensei args <tool>\` on something"; return 0; }
  local f name
  for f in "$SPEC_CACHE"/*.top; do
    [ -e "$f" ] || continue
    name="$(awk -F'|' '$1=="T"{print $2; exit}' "$f")"
    printf '%s\n' "${name:-${f##*/}}"
  done | sort -u
}

# skip a wrapper prefix (sudo nmap ..., proxychains curl ...) so word[$off] is
# the actual tool being looked up, not the thing running it
_spec_skip_wrappers() {  # prints the index of the real tool word, given argv words on stdin (one per line) up to a bound
  local bound="$1"; shift
  local off=0 w
  while [ "$off" -lt "$bound" ]; do
    w="${1:-}"; shift || true
    case "$w" in sudo|doas|proxychains|proxychains4) off=$((off+1)) ;; *) break ;; esac
  done
  printf '%s' "$off"
}

# does the FLAG placeholder text look like a path? (wordlist, output file,
# basename, logfile, ...) — used to fall back to real filename completion for
# a value we can't enumerate, instead of offering nothing on Tab. Case-
# insensitive: a discovered metavar's casing is whatever the tool's own
# --help used (FILE, File, file, ...), not something sensei controls anymore.
_looks_like_path() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *file*|*path*|*wordlist*|*basename*|*output*|*log*|*dir*) return 0 ;;
    *) return 1 ;;
  esac
}

# best-effort: which subcommand (if any) has already been typed among
# words[start..end) — prints it, empty if none/tool has no subcommands
_spec_chosen_sub() {  # $1=tool $2=start $3=end -- word0 word1 ...
  local tool="$1" start="$2" end="$3"; shift 3
  local -a w=("$@")
  local i
  for ((i = start; i < end; i++)); do
    if _spec_is_sub "$tool" "${w[$i]}"; then printf '%s' "${w[$i]}"; return; fi
  done
}

# keyword discovery: you don't always remember a flag's PREFIX, just some
# word buried in it -- "admin" for --count-admin, no idea it starts with
# "count" or even that it needs "--" at all. Given "name<TAB>desc" rows and
# a keyword, ranks by how directly the keyword identifies the name. The
# tiers, highest first, and why each one outranks the next:
#   6 whole flag name equals the query exactly -- "user" for --user: this
#     word doesn't just appear in the name, it IS the name.
#   5 one hyphen-word equals the query exactly, but the flag has OTHER
#     words too -- "user" for --target-user or --user-agent: a precise
#     match, just on a component, not the whole concept.
#   4 a hyphen-word STARTS WITH the query, but isn't equal to it --
#     "user" for --username: same idea, less precisely typed.
#   3 a hyphen-word merely CONTAINS the query -- "erif" inside
#     "verification": the weakest kind of real word-level match.
#   2 the query only shows up once every hyphen is removed -- a compound
#     match that ignores word boundaries entirely.
#   1 the query is nowhere in the name at all, only in the description --
#     by far the weakest signal, but "I don't remember the flag, only
#     what it does" is still a real thing to search by.
# Tiers 6 and 5 both mean "some real, exact word matched" -- what
# distinguishes them is precision, not existence, which is exactly the
# distinction the OLD version of this function couldn't draw (it scored
# --user and --target-user identically for "user", leaving nothing but
# incidental sort order to tell them apart). Ties within a tier fall back
# to the SHORTER candidate name first: it represents a larger fraction of
# the query's concept, so it's the more specific, more likely-intended
# match -- a generic, no-hardcoded-words rule, not a special case for any
# particular flag.
# This is a FALLBACK, not the primary filter: callers try an exact prefix
# match first (fast, precise, keeps "-s<Tab>" behaving exactly as before)
# and only reach for this when that comes back with nothing -- see
# _match_with_related for how a DASHLESS query (which can structurally
# never satisfy a literal prefix match against a dashed flag) instead goes
# straight here as its OWN primary path, not a last-resort fallback.
#
# The BOUNDARY of this, stated plainly rather than chased with more
# regex: every tier above is LEXICAL -- substring, prefix, and exact
# comparisons against the literal characters in a name. "certificate"
# will never find --disable-ssl-verification this way, because the two
# strings share no substring; a human reading the flag understands the
# CONCEPT, this function only ever compares TEXT. Closing that gap for
# real needs a semantic layer (embeddings, or an LLM) sitting ALONGSIDE
# this lexical one -- feeding the same unified specification, not
# replacing how it's queried -- and that's a real architectural addition
# to make deliberately, not something to fake by piling on synonym
# regexes here until this function can no longer be reasoned about.
_keyword_rank() {  # $1=keyword [$2=desc field, default 2] [$3=min score, default 1]
  # rows (tab-separated, name always $1) on stdin -> same rows, ranked, ANY
  # other fields (value/enum, if the caller has them) passed through
  # untouched -- only the name and description fields drive scoring.
  local kw="$1" df="${2:-2}" minscore="${3:-1}"
  [ -n "$kw" ] || return 0
  awk -F'\t' -v kw="$kw" -v df="$df" -v minscore="$minscore" '
    function lc(s) { return tolower(s) }
    BEGIN {
      lkw = lc(kw)
      gsub(/^--?/, "", lkw)
      if (lkw == "") exit
    }
    {
      name = $1; desc = $df
      base = name; gsub(/^--?/, "", base)
      lbase = lc(base)
      nodash = base; gsub(/-/, "", nodash)
      n = split(base, w, "-")
      score = 0
      if (lbase == lkw) score = 6
      if (score == 0) {
        for (i = 1; i <= n; i++) { if (lc(w[i]) == lkw) { score = 5; break } }
      }
      if (score == 0) {
        for (i = 1; i <= n; i++) { if (index(lc(w[i]), lkw) == 1) { score = 4; break } }
      }
      if (score == 0) {
        for (i = 1; i <= n; i++) { if (index(lc(w[i]), lkw) > 0) { score = 3; break } }
      }
      if (score == 0 && index(lc(nodash), lkw) > 0) score = 2
      if (score == 0 && desc != "" && index(lc(desc), lkw) > 0) score = 1
      if (score >= minscore && score > 0) print score "\t" length(base) "\t" $0
    }' | sort -t $'\t' -k1,1rn -k2,2n | cut -f3-
}

# exact-prefix rows only -- unchanged, always the fast/primary path.
_prefix_match() {  # $1=query; "name<TAB>..." rows on stdin
  local q="$1"
  awk -F'\t' -v q="$q" 'q=="" || index($1,q)==1'
}

# keyword-related rows NOT already covered by an exclude-list, for
# SUPPLEMENTING an existing result rather than replacing it -- an exact
# prefix match ("--user-agent" for "--user") should never make sensei go
# quiet about "--current-user"/"--create-user" just because it already
# found something else. Two guards keep this from turning into noise:
# a query under 3 chars (once a leading dash or two is stripped) is
# exactly what prefix matching already does well, so it's left alone here;
# and the caller sets min-score to demand a real word-level match
# (_keyword_rank's tier 3 or better) before appending anything -- the
# weaker tiers (hyphens ignored entirely, or only in the description) are
# reserved for _match_with_related's own last-resort fallback, where any
# signal beats none.
_keyword_extra() {  # $1=query $2=desc-field $3=exclude-names(newline list) $4=min-score(default 3)
  local q="$1" df="$2" exclude="$3" minscore="${4:-3}"
  local stripped="${q#--}"; stripped="${stripped#-}"
  [ "${#stripped}" -ge 3 ] || return 0
  _keyword_rank "$q" "$df" "$minscore" | awk -F'\t' -v ex="$exclude" '
    BEGIN { n = split(ex, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") seen[a[i]] = 1 }
    !($1 in seen)
  '
}

# the "exact prefix, plus anything conceptually related, folding the
# related set into primary if prefix matching found nothing" sequence --
# shared by the subs/flags sections of `cmd_args` and by `cmd_complete`, so
# the ranking/fallback policy lives in exactly one place instead of being
# hand-copied at each call site (and risking the three silently drifting
# apart). Sets globals rather than echoing, since callers need BOTH pieces.
MWR_PRIMARY=""
MWR_EXTRA=""
_match_with_related() {  # $1=allrows $2=filter $3=desc-field(for _keyword_extra)
  local allrows="$1" filter="$2" df="$3"
  MWR_PRIMARY=""
  MWR_EXTRA=""
  case "$filter" in
    -*|"")
      # dash-prefixed (or empty): a genuine prefix-completion query -- the
      # literal, exact prefix match stays fast and precise, unchanged from
      # before (this is the "-s<Tab>" path). Min-score 4 for the
      # supplement means "a real word match, prefix-or-better" -- the old
      # 3 (word-substring) is now one tier weaker than that, since the
      # ranking hierarchy grew a tier (see _keyword_rank); tuned to keep
      # this path's behavior the same shape as before the rescoring.
      MWR_PRIMARY="$(printf '%s\n' "$allrows" | _prefix_match "$filter")"
      if [ -n "$filter" ]; then
        local shown ms
        shown="$(printf '%s\n' "$MWR_PRIMARY" | cut -f1)"
        ms=4; [ -z "$MWR_PRIMARY" ] && ms=1
        MWR_EXTRA="$(printf '%s\n' "$allrows" | _keyword_extra "$filter" "$df" "$shown" "$ms")"
      fi
      if [ -z "$MWR_PRIMARY" ] && [ -n "$MWR_EXTRA" ]; then
        MWR_PRIMARY="$MWR_EXTRA"; MWR_EXTRA=""
      fi
      ;;
    *)
      # dashless: this can NEVER satisfy a literal prefix match against a
      # dashed flag name (every real flag starts with a dash the query
      # doesn't have), so treating "prefix found nothing" as the trigger
      # for the weakest keyword tier meant every dashless query landed in
      # the noisiest mode by construction -- backwards, since "I only
      # remember a concept" is the more natural query shape here, not a
      # degraded one. This goes straight to keyword ranking as its OWN
      # primary path instead of a fallback: an exact whole-or-word match
      # (score 5/6) is primary, a softer word-level match (3/4) is "also
      # related," and only when NEITHER finds anything does this drop to
      # the weak tiers (2: hyphens ignored entirely, 1: description-only)
      # as a genuine last resort -- never the default just because "--"
      # was left off.
      [ "${#filter}" -ge 3 ] || return 0
      MWR_PRIMARY="$(printf '%s\n' "$allrows" | _keyword_rank "$filter" "$df" 5)"
      local shown
      shown="$(printf '%s\n' "$MWR_PRIMARY" | cut -f1)"
      MWR_EXTRA="$(printf '%s\n' "$allrows" | _keyword_extra "$filter" "$df" "$shown" 3)"
      if [ -z "$MWR_PRIMARY" ] && [ -z "$MWR_EXTRA" ]; then
        MWR_PRIMARY="$(printf '%s\n' "$allrows" | _keyword_rank "$filter" "$df" 1)"
      fi
      ;;
  esac
}

# ── sensei args — human-facing: what comes next, right now ────────────────────
# `sensei args nmap -sC -sV -` and `sensei args nmap` both work; so does a
# single quoted string (that's what the C-s H popup passes). First call for a
# given tool triggers its (cached-after-this) --help probe -- see
# _ensure_top_cache -- so this can take a moment the very first time.
cmd_args() {
  [ "$#" -ge 1 ] || die "usage: sensei args <tool> [args typed so far...]"
  local -a words
  if [ "$#" -eq 1 ]; then read -r -a words <<< "$1"; else words=("$@"); fi
  local n="${#words[@]}"
  [ "$n" -gt 0 ] || die "nothing to look up"

  local off; off=$(_spec_skip_wrappers "$n" "${words[@]}")
  local tool="${words[$off]:-}"
  [ -n "$tool" ] || die "nothing to look up (just a wrapper prefix, no tool named)"

  _spec_have_tool "$tool" || die "not found on PATH: $tool"

  if [ -z "$(_spec_flags_expanded "$tool" "")" ] && [ -z "$(_spec_subs "$tool")" ] && [ -z "$(_spec_named "$tool" "")" ]; then
    local summary; summary="$(_spec_tool_summary "$tool")"
    if [ "$summary" = "$tool" ]; then
      # _ensure_top_cache's own sentinel for "genuinely no output at all" --
      # already established during discovery, so there's nothing new a
      # second probe would find. Don't pay for one (a tool that hangs or
      # traps signals already cost the discovery probe its full bounded
      # timeout once; re-probing here would be that cost again for nothing).
      printf '  %s is on PATH, but --help/-h produced no output at all.\n' "$tool"
    else
      printf '  %s is on PATH, but --help/-h came back in a shape this parser\n' "$tool"
      printf '  could not make sense of. Its raw output:\n\n'
      _probe_help "$tool"
    fi
    return 0
  fi

  printf '  %s — %s\n' "$tool" "$(_spec_tool_summary "$tool")"

  local sub; sub=$(_spec_chosen_sub "$tool" "$((off+1))" "$n" "${words[@]}")
  [ -n "$sub" ] && printf '  subcommand: %s\n' "$sub"
  if [ "$n" -gt "$((off+1))" ]; then
    printf '  already typed: %s\n' "${words[*]:$((off+1))}"
  fi

  # _spec_flags_expanded rows are alias|value|desc|enum -- computed once
  # here and reused below both for glued-value detection and the flags
  # listing, instead of re-querying the same (tool, sub) pair twice.
  local allflags; allflags=$(_spec_flags_expanded "$tool" "$sub"; _spec_named "$tool" "$sub")

  # last word is a KNOWN flag that takes a value -> that's the whole answer;
  # anything else on the line right now is a distraction, don't list it too
  local last="" vinfo="" filter="" awaiting_value=0
  if [ "$n" -gt "$((off+1))" ]; then
    last="${words[$((n-1))]}"
    vinfo=$(_spec_flag_value "$tool" "$sub" "$last")
    if [ -n "$vinfo" ]; then
      local val="${vinfo%%$'\t'*}" enum="${vinfo#*$'\t'}"
      # the ONE row matching what you just typed -- exact match, so this is
      # the detailed single-item view: worth showing WHERE this came from
      # and how sure sensei is, not just clutter for the compact list below.
      local meta; meta=$(printf '%s\n' "$allflags" | awk -F'\t' -v f="$last" '$1==f{print $5"\t"$6"\t"$7; exit}')
      if [ "$val" != "-" ]; then
        awaiting_value=1
        printf '  \xe2\x80\xba %s expects %s\n' "$last" "$val"
        [ -n "$enum" ] && printf '    one of: %s\n' "${enum//,/, }"
      else
        # a complete, recognized flag that reads as boolean -- show its own
        # description (this is also what a value-taking flag looks like when
        # the source --help was too irregular for tier 1 to split the value
        # out; see the parser comment above) before falling through to "what
        # else can I add", so that degraded case isn't just silently dropped.
        local own; own=$(printf '%s\n' "$allflags" | awk -F'\t' -v f="$last" '$1==f{print $3; exit}')
        [ -n "$own" ] && printf '  \xe2\x80\xba %s: %s\n' "$last" "$own"
      fi
      if [ -n "$meta" ]; then
        printf '%s\n' "$meta" | awk -F'\t' '$1!=""{printf "    source: %s   location: %s   confidence: %s\n", $1, $2, $3}'
      fi
    else
      # not a flag on its own -- but the value might be glued directly onto
      # it with no space, nmap-style ("-T4" for "-T <0-5>"): find the known
      # value-taking flag that's a genuine prefix of what was typed.
      local glued; glued=$(printf '%s\n' "$allflags" | awk -F'\t' -v last="$last" '
        $2 != "-" && length($1) < length(last) && index(last, $1) == 1 { print; exit }')
      if [ -n "$glued" ]; then
        local galias gval gdesc genum gsrc gloc gconf
        IFS=$'\t' read -r galias gval gdesc genum gsrc gloc gconf <<<"$glued"
        awaiting_value=1
        printf '  \xe2\x80\xba %s expects %s (glued onto %s, no space)\n' "$last" "$gval" "$galias"
        [ -n "$genum" ] && printf '    one of: %s\n' "${genum//,/, }"
        [ -n "$gsrc" ] && printf '    source: %s   location: %s   confidence: %s\n' "$gsrc" "$gloc" "$gconf"
      else
        # anything you typed that ISN'T the subcommand you just picked is
        # something to narrow by -- with or without a leading dash. You don't
        # always remember a flag's prefix, just a word buried in it ("admin"
        # for --count-admin) -- see _keyword_rank for how that's found.
        [ "$last" != "$sub" ] && filter="$last"
      fi
    fi
  fi
  [ "$awaiting_value" -eq 1 ] && return 0
  printf '\n'

  # no subcommand chosen yet, and there's more than one -> list them,
  # narrowed by the same filter as the flags below: an exact prefix match
  # first, PLUS anything conceptually related that isn't already in it (an
  # exact hit on one subcommand shouldn't make sensei go quiet about others
  # just because it already found something) -- shown as its own clearly-
  # separate section rather than silently merged into the first, so an
  # exact match is never buried among weaker ones.
  if [ -z "$sub" ]; then
    local allsubs; allsubs=$(_spec_subs "$tool")
    if [ -n "$allsubs" ]; then
      _match_with_related "$allsubs" "$filter" 2
      if [ -n "$MWR_PRIMARY" ]; then
        printf '  subcommands%s:\n' "${filter:+ matching \"$filter\"}"
        printf '%s\n' "$MWR_PRIMARY" | awk -F'\t' '{printf "    %-14s %s\n", $1, $2}'
        printf '\n'
      fi
      if [ -n "$MWR_EXTRA" ]; then
        printf '  also related to "%s":\n' "$filter"
        printf '%s\n' "$MWR_EXTRA" | awk -F'\t' '{printf "    %-14s %s\n", $1, $2}'
        printf '\n'
      fi
    fi
  fi

  # _spec_flags_expanded rows are alias|value|desc|enum -- description is
  # field 3, not _match_with_related's default of 2; told explicitly below.
  _match_with_related "$allflags" "$filter" 3
  printf '  flags%s%s:\n' "${sub:+ ($sub)}" "${filter:+ matching \"$filter\"}"
  if [ -n "$MWR_PRIMARY" ]; then
    printf '%s\n' "$MWR_PRIMARY" | awk -F'\t' '{
      v = ($2 == "-") ? "" : $2
      printf "    %-16s %-18s %s\n", $1, v, $3
    }'
  fi
  if [ -n "$MWR_EXTRA" ]; then
    printf '\n  also related to "%s":\n' "$filter"
    printf '%s\n' "$MWR_EXTRA" | awk -F'\t' '{
      v = ($2 == "-") ? "" : $2
      printf "    %-16s %-18s %s\n", $1, v, $3
    }'
  fi
}

# ── sensei args-popup — C-s H: same thing, live, prefilled from the pane ──────
# Best-effort capture of the CURRENT (unsent) line in a pane, so "what comes
# next" can be asked about whatever you're mid-typing without leaving the
# keyboard to retype it. Never sends anything anywhere — pure lookup, same
# Law #3 spirit as `burst`: sensei reads what you typed, it doesn't act on it.
cmd_lastline() {
  local pane="${1:?pane_id}"
  # the line you're mid-typing is wherever the CURSOR is, not "the last line
  # of the pane" — capture-pane's line numbering runs negative into scrollback
  # above the visible area and can run past the prompt into blank space below
  # it too, so target the cursor's row explicitly rather than guess an offset.
  local y; y=$("${TM[@]}" display-message -p -t "$pane" '#{cursor_y}' 2>/dev/null)
  local line
  if [ -n "$y" ]; then
    line=$("${TM[@]}" capture-pane -p -t "$pane" -S "$y" -E "$y" 2>/dev/null)
  else
    line=$("${TM[@]}" capture-pane -p -t "$pane" 2>/dev/null | tail -1)
  fi
  # strip a shell-prompt prefix ending in $/#/> + space. Anchored on the
  # FIRST such marker: a real prompt is always at the very start of the
  # captured line, and matching leftmost (rather than a greedy `.*` that
  # finds the LAST one) means a typed command with its own `$#>` further in
  # -- `echo $HOME`, `curl url?a=1#frag`, or a redirect like `... > out.txt`
  # -- doesn't get mistaken for extra prompt text and truncated away. Those
  # examples don't actually collide with the boundary either way here, since
  # the delimiter must be immediately followed by a space to count.
  printf '%s' "$line" | sed -E 's/^[^$#>]*[$#>] //'
}

cmd_args_popup() {
  local pane="${1:?pane_id}"
  local pre; pre="$(cmd_lastline "$pane")"
  local line
  printf '  sensei args — edit the line, Enter to look up, empty line to close\n\n'
  while IFS= read -r -e -p '  args> ' -i "$pre" line; do
    [ -n "$line" ] || break
    printf '\n'
    cmd_args "$line" 2>&1 | less
    pre="$line"
  done
}

# ── sensei complete — machine-facing: feeds real shell Tab-completion ─────────
# Called by the bash/zsh completion functions `sensei setup-shell` wires up.
# Prints one candidate per line as "token<TAB>description" (bash keeps just the
# token; zsh's wrapper uses both for a described menu). A lone `@@FILE@@` line
# means "fall back to normal filename completion" — used for value slots whose
# format is a path we can't otherwise enumerate.
cmd_complete() {
  local cword="${1:?cword}"; shift
  local -a words=("$@")
  local n="${#words[@]}"
  [ "$cword" -ge 0 ] && [ "$cword" -lt "$n" ] || return 0
  local cur="${words[$cword]}"

  local off; off=$(_spec_skip_wrappers "$cword" "${words[@]}")
  local tool="${words[$off]:-}"
  [ -n "$tool" ] && _spec_have_tool "$tool" || return 0
  # still typing the tool's own name (cword hasn't moved past it yet) --
  # that's plain command-name completion, not "what comes next for this
  # tool," even if the partial word so far happens to already be a valid
  # binary on PATH (e.g. "ls" while aiming for "lsblk"). bash has no
  # equivalent of zsh's own `CURRENT > 1` guard for this, so enforce it here
  # once for both.
  [ "$cword" -gt "$off" ] || return 0

  local sub; sub=$(_spec_chosen_sub "$tool" "$((off+1))" "$cword" "${words[@]}")

  if [ "$cword" -gt "$off" ]; then
    local prev="${words[$((cword-1))]}"
    local vinfo; vinfo=$(_spec_flag_value "$tool" "$sub" "$prev")
    if [ -n "$vinfo" ]; then
      local val="${vinfo%%$'\t'*}" enum="${vinfo#*$'\t'}"
      if [ "$val" != "-" ]; then
        if [ -n "$enum" ]; then
          printf '%s\n' "${enum//,/$'\n'}" | awk -v cur="$cur" 'index($0,cur)==1{print $0"\t"}'
        elif _looks_like_path "$val"; then
          printf '@@FILE@@\n'
        fi
        return 0
      fi
    fi
  fi

  local candidates rows
  rows="$({ [ -z "$sub" ] && _spec_subs "$tool"
            _spec_flags_expanded "$tool" "$sub" | awk -F'\t' '{print $1"\t"$3}'
            _spec_named "$tool" "$sub" | awk -F'\t' '{print $1"\t"$3}'
          })"
  # Beyond the exact prefix match, also surface anything conceptually
  # related that isn't already in it -- an exact hit on --user-agent
  # shouldn't make sensei go quiet about --current-user/--create-user just
  # because it already found something for "user". Appended after, not
  # instead of, so the precise match still comes first (same policy as
  # `cmd_args` -- see _match_with_related).
  _match_with_related "$rows" "$cur" 2
  candidates="$MWR_PRIMARY"
  [ -n "$MWR_EXTRA" ] && candidates="${candidates:+$candidates$'\n'}$MWR_EXTRA"
  [ -n "$candidates" ] && printf '%s\n' "$candidates"
}

# ── vpn/iface indicator ───────────────────────────────────────────────────────
# Shows the interface I'm actually attacking from. If this is blank and I'm
# about to run something, that's the reminder I needed.
# Shows EVERY attack-relevant interface, VPN/tunnels first (that's your attacker
# IP), then the egress LAN IP dim. Screams red if no tunnel is up — a dropped VPN
# mid-exam is a silent killer. Emits tmux #[...] style codes; the status bar
# interprets them. `sensei vpn` = status readout · `sensei ip` = full popup list.
_ip_tuns() { ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^(tun|tap|wg|ppp)/ {split($4,a,"/"); print $2, a[1]}'; }
_ip_lan()  { ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(tun|tap|wg|ppp|lo|docker|br-|veth)/ {split($4,a,"/"); print $2, a[1]; exit}'; }
_ip_all()  { ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print $2, a[1]}'; }

# robust clipboard: copy to the real OS clipboard via whatever tool exists, AND
# to the tmux buffer (+OSC52) so paste works inside tmux and over SSH. Text comes
# from args ("sensei clip 10.10.14.7") or stdin (used by mouse copy-pipe).
cmd_clip() {
  local data
  if [ "$#" -gt 0 ]; then data="$*"; else data="$(cat)"; fi
  [ -n "$data" ] || return 0
  if   command -v wl-copy >/dev/null 2>&1; then printf '%s' "$data" | wl-copy >/dev/null 2>&1
  elif command -v xclip   >/dev/null 2>&1; then printf '%s' "$data" | xclip -selection clipboard >/dev/null 2>&1
  elif command -v xsel    >/dev/null 2>&1; then printf '%s' "$data" | xsel  --clipboard --input   >/dev/null 2>&1
  elif command -v pbcopy  >/dev/null 2>&1; then printf '%s' "$data" | pbcopy >/dev/null 2>&1
  fi
  printf '%s' "$data" | "${TM[@]}" load-buffer -w - >/dev/null 2>&1 || true
  local show; show=$(printf '%s' "$data" | head -c 40)
  "${TM[@]}" display-message "  copied: $show" 2>/dev/null || true
}

cmd_vpn() {
  # this runs on every status-bar redraw (status-interval, every 5s) — one `ip`
  # call shared for both the tunnel and LAN lookups instead of two, since
  # that's the whole cost of this function beyond bash's own startup.
  local raw; raw=$(ip -4 -o addr show 2>/dev/null)
  local out="" iface addr lan up=0
  while read -r iface addr; do
    [ -n "$iface" ] && { out="$out#[fg=colour107,bold]$iface #[fg=colour223]$addr#[default]  "; up=1; }
  done < <(printf '%s\n' "$raw" | awk '$2 ~ /^(tun|tap|wg|ppp)/ {split($4,a,"/"); print $2, a[1]}')
  # ACTIVE alert on the up->down transition, not just a red label that only
  # helps if you're already looking at the bar. A dropped tunnel mid-scan is
  # the "silent killer" the comment above already calls out; a passive color
  # never actually pages you. Fires once per drop, not once per redraw — and
  # never on the very first check (no VPN yet just means you haven't
  # connected, not that it dropped).
  local stf="$STATE/vpn_up" was=0
  [ -f "$stf" ] && was=$(cat "$stf" 2>/dev/null); [ -n "$was" ] || was=0
  if [ "$up" -eq 0 ] && [ "$was" = "1" ]; then
    "${TM[@]}" display-message -d 4000 "  ⚠ VPN TUNNEL DROPPED — you are off the attacker network" 2>/dev/null
  fi
  [ -d "$STATE" ] || mkdir -p "$STATE"   # builtin stat first; only forks mkdir the one time it's missing
  printf '%s' "$up" > "$stf" 2>/dev/null
  [ -z "$out" ] && out="#[fg=colour203,bold]NO-VPN#[default]  "
  # matches _ip_lan's original `ip ... scope global` pre-filter, now done in
  # awk instead since we're reusing the one shared, unfiltered `ip` snapshot
  lan=$(printf '%s\n' "$raw" | awk '/scope global/ && $2 !~ /^(tun|tap|wg|ppp|lo|docker|br-|veth)/ {split($4,a,"/"); print $2, a[1]; exit}')
  [ -n "$lan" ] && out="$out#[fg=colour244]${lan% *} ${lan#* }#[default]"
  printf '%s' "$out"
}

# full-screen readout for a popup — plain text, big, copy-friendly
cmd_ip() {
  printf '  ATTACKER INTERFACES\n\n'
  ip -4 -o addr show scope global 2>/dev/null \
    | awk '{split($4,a,"/"); printf "    %-10s %s\n", $2, a[1]}'
  local t; t=$(_ip_tuns | awk 'NR==1{print $2}')
  printf '\n'
  if [ -n "${t:-}" ]; then printf '  >> attacker IP (tun): %s\n' "$t"
  else printf '  >> (!) NO VPN INTERFACE UP\n'; fi
}

# one keystroke: copy the tunnel (attacker) IP to the OS clipboard
cmd_ipcopy() {
  local ip; ip=$(_ip_tuns | awk 'NR==1{print $2}')
  [ -n "${ip:-}" ] || { "${TM[@]}" display-message "  no VPN interface up"; return 1; }
  cmd_clip "$ip"
}

# clickable menu of every IP — click a line (or press its number) to copy that IP
cmd_ipmenu() {
  local i=1 iface addr
  local -a menu=()
  while read -r iface addr; do
    [ -n "$iface" ] || continue
    menu+=( "$iface   $addr" "$i" "run-shell 'sensei clip $addr'" )
    i=$((i+1))
  done < <(_ip_all)
  [ "${#menu[@]}" -gt 0 ] || { "${TM[@]}" display-message "  no IPs found"; return 1; }
  "${TM[@]}" display-menu -T "#[align=centre]click an IP to copy" -x C -y C "${menu[@]}"
}

# ── numbered paste-buffer picker ───────────────────────────────────────────────
# Every `y` copy (and every mouse-drag copy) already lands in a numbered tmux
# buffer — this just gives you a fast way back to one of the last few without
# `choose-buffer`'s full-screen picker. Shows a preview so you're not guessing
# which slot has what.
cmd_bufmenu() {
  local i=1 name preview key
  # quick single-key select for all 20 slots — tmux menu keys must be a single
  # keystroke, so past 9 this can't just be "10", "11"... : digits 1-9, then 0
  # for the 10th, then a-j for the 11th through 20th. Arrow keys + Enter (or a
  # click) still work on every slot regardless.
  local letters="abcdefghij"
  local -a menu=()
  while read -r name; do
    [ -n "$name" ] || continue
    preview=$("${TM[@]}" show-buffer -b "$name" 2>/dev/null | head -c 50 | tr '\n' ' ')
    # skip buffers with nothing to show (an empty selection copied by accident,
    # or all-whitespace content) — an empty numbered slot is just clutter, and
    # skipping it here (before $i advances) keeps the visible list gap-free
    case "$preview" in *[![:space:]]*) ;; *) continue ;; esac
    # display-menu item names are tmux FORMAT strings — tmux runs #(shell-command)
    # in them at render time, with no interaction needed. Buffer content is
    # whatever you copied with `y` in copy-mode, which can be scrollback from a
    # target/remote host: a hostname or filename containing "#(...)" would
    # execute on YOUR machine the instant this menu is drawn. Escape every '#'
    # to tmux's own literal-# form ('##') before it ever reaches display-menu.
    preview=${preview//#/##}
    case "$i" in
      [1-9]) key="$i" ;;
      10)    key=0 ;;
      *)     key="${letters:$((i-11)):1}" ;;
    esac
    menu+=( "$i: $preview" "$key" "paste-buffer -b $name" )
    i=$((i+1))
    [ "$i" -gt 20 ] && break   # only the 20 most recent — beyond that, choose-buffer
  done < <("${TM[@]}" list-buffers -F '#{buffer_name}' 2>/dev/null)
  [ "${#menu[@]}" -gt 0 ] || { say "no buffers yet — copy something first"; return 1; }
  "${TM[@]}" display-menu -T "#[align=centre]paste buffer" -x C -y C "${menu[@]}"
}

# ── cross-pane search ──────────────────────────────────────────────────────────
# Copy-mode's grep-layer (M-i/M-t/etc) only searches the pane you're already in.
# When you're 8 panes deep this answers "which pane had that IP/error" instead
# of you tabbing through each one by hand — greps every pane's scrollback and
# hands you a pick-list of which panes matched.
#
# Capped to the last SENSEI_FINDALL_LINES lines per pane (default 5000), not
# the full history — history-limit is 200000, and a pane that's been running
# a long burst really can hold that much. Full-history grep on every pane in
# a busy session would mean a real, felt pause every time you press F, for
# scrollback that's realistically almost always near the tail anyway. Set
# SENSEI_FINDALL_LINES=0 for the old unbounded behavior when you actually
# need to search that far back.
cmd_findall() {
  local sess="${1:?session}" pattern="${2:?pattern}"
  local lines="${SENSEI_FINDALL_LINES:-5000}"
  local -a cap=(-S -)
  [ "$lines" != "0" ] && cap=(-S "-$lines")
  local -a matches=()
  local pid count
  while read -r pid; do
    [ -n "$pid" ] || continue
    count=$("${TM[@]}" capture-pane -t "$pid" -p "${cap[@]}" -J 2>/dev/null | grep -Ec -- "$pattern" 2>/dev/null)
    [ -n "$count" ] && [ "$count" -gt 0 ] 2>/dev/null && matches+=("${pid}|${count}")
  done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}' 2>/dev/null)
  [ "${#matches[@]}" -gt 0 ] || { say "no matches for: $pattern (last $lines lines/pane — SENSEI_FINDALL_LINES=0 to search everything)"; return 1; }
  local i=1 m pid2 cnt2
  local -a menu=()
  for m in "${matches[@]}"; do
    pid2="${m%%|*}"; cnt2="${m#*|}"
    menu+=( "$pid2  ($cnt2 hits)" "$i" "select-pane -t $pid2" )
    i=$((i+1))
  done
  "${TM[@]}" display-menu -T "#[align=centre]panes matching: $pattern" -x C -y C "${menu[@]}"
}

# ── command duration for the pane border ───────────────────────────────────────
# pane_current_command tells you WHAT's running, not for how long. Paired with
# monitor-silence's "(quiet)" tag, this is the difference between "still
# working" and "probably hung" at a glance across a dozen windows. Refreshed on
# status-interval like the VPN indicator; state keyed per pane so a command
# change (new foreground process) resets the clock.
cmd_cmdtime() {
  local pane="${1:?pane_id}" cmd="${2:-}"
  local f="$STATE/cmdtime_${pane#%}" now started prevcmd
  # $EPOCHSECONDS is a bash 4.2+ builtin — no fork, unlike `date +%s`. Falls
  # back to date on macOS's stock /bin/bash (still 3.2, frozen pre-GPLv3),
  # where the builtin is unset and would otherwise silently arithmetic-evaluate
  # as 0, not fail loudly.
  now=${EPOCHSECONDS:-$(date +%s)}
  if [ -f "$f" ]; then read -r started prevcmd < "$f"; fi
  if [ -z "${started:-}" ] || [ "${prevcmd:-}" != "$cmd" ]; then
    started="$now"
    [ -d "$STATE" ] || mkdir -p "$STATE"   # builtin stat first; only forks mkdir the one time it's missing
    printf '%s %s\n' "$started" "$cmd" > "$f" 2>/dev/null
  fi
  local elapsed=$((now - started))
  if   [ "$elapsed" -lt 60 ];   then printf '%ds' "$elapsed"
  elif [ "$elapsed" -lt 3600 ]; then printf '%dm' $((elapsed / 60))
  else                               printf '%dh%02dm' $((elapsed / 3600)) $(((elapsed % 3600) / 60))
  fi
}

# ── evidence logging ──────────────────────────────────────────────────────────
sess_dir() { printf '%s/%s' "$LOOT" "$1"; }

log_arm_pane() {   # $1 session  $2 pane_id
  local d ts f
  d=$(sess_dir "$1"); mkdir -p "$d/panes"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  f="$d/panes/${ts}_${2#%}.log"
  printf '# session=%s pane=%s started=%s host=%s\n' "$1" "$2" "$ts" "$(hostname)" > "$f"
  # pipe-pane only captures output from this point forward. If logging gets
  # armed late (the whole point of Law #4 is that this shouldn't cost you
  # anything) whatever's already sitting in scrollback would otherwise just be
  # lost the moment the pane closes — so backfill it before going live.
  local backfill; backfill=$("${TM[@]}" capture-pane -t "$2" -p -S - -J 2>/dev/null)
  if [ -n "$backfill" ]; then
    printf '# --- backfilled scrollback (existed before logging was armed) ---\n' >> "$f"
    printf '%s\n' "$backfill" >> "$f"
    printf '# --- live capture begins here ---\n' >> "$f"
  fi
  "${TM[@]}" pipe-pane -t "$2" -o "cat >> '$f'"
}

cmd_log() {
  local action="${1:-status}" sess="${2:-}" pane="${3:-}"
  [ -n "$sess" ] || sess=$("${TM[@]}" display -p '#{session_name}')
  local cur; cur=$("${TM[@]}" show -t "$sess" -v @log 2>/dev/null || true)
  case "$action" in
    toggle)
      if [ -n "$cur" ]; then
        "${TM[@]}" set -t "$sess" -u @log
        while read -r p; do "${TM[@]}" pipe-pane -t "$p"; done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}')
        say "logging OFF · $sess"
      else
        "${TM[@]}" set -t "$sess" @log 1
        while read -r p; do log_arm_pane "$sess" "$p"; done < <("${TM[@]}" list-panes -s -t "$sess" -F '#{pane_id}')
        say "logging ON  · $(sess_dir "$sess")/panes"
      fi ;;
    inherit)
      # runs on EVERY new pane (after-split-window / after-new-window), logging
      # armed or not. The nested tmux call just above (show -t ... -v @log) can
      # race a just-created pane into copy-mode before its shell ever starts —
      # so the very next keys typed into it (by a human, or by `sensei burst`)
      # get read as copy-mode navigation and silently vanish instead of being
      # typed. Cancel unconditionally; it's a no-op on a pane not in a mode.
      [ -n "$pane" ] && "${TM[@]}" send-keys -t "$pane" -X cancel 2>/dev/null
      [ -n "$cur" ] && [ -n "$pane" ] && log_arm_pane "$sess" "$pane" ;;
    status)  [ -n "$cur" ] && echo on || echo off ;;
    *) die "log: toggle|inherit|status" ;;
  esac
}

# ── scrollback -> case file ───────────────────────────────────────────────────
cmd_dump() {
  local pane="${1:?pane_id}" sess="${2:-$("${TM[@]}" display -p '#{session_name}')}"
  local d f; d=$(sess_dir "$sess"); mkdir -p "$d/scrollback"
  f="$d/scrollback/$(date -u +%Y%m%dT%H%M%SZ)_${pane#%}.txt"
  "${TM[@]}" capture-pane -t "$pane" -p -S - -J > "$f"
  say "dumped $(wc -l < "$f") lines -> $f"
}

# ── notebook ──────────────────────────────────────────────────────────────────
cmd_notes() {
  local sess="${1:?session}" d; d=$(sess_dir "$sess"); mkdir -p "$d"
  [ -f "$d/notes.md" ] || {
    printf '# %s\n\nopened: %s\nscope:\n  - \n\n## findings\n\n## loose ends\n\n' \
      "$sess" "$(date -u +%F\ %TZ)" > "$d/notes.md"; }
  exec "${EDITOR:-vi}" "$d/notes.md"
}

# ── case skeleton ─────────────────────────────────────────────────────────────
# One session per target. Windows are named by phase, never auto-renamed.
cmd_case() {
  local name="${1:?case name}" d; no_traversal "$name"; d=$(sess_dir "$name")
  mkdir -p "$d"/{panes,scrollback,evidence,tools-out}
  # tmux silently replaces '.' and ':' in session names (they're target-string
  # separators) — e.g. `sensei case acme.tld`, the exact example in the README
  # and the installer's own onboarding text, actually creates a session named
  # "acme_tld". Every "=$name" target below would then fail to find it, leaving
  # a stub session with only the "recon" window and no @target set. Sanitize
  # the SESSION name only; the loot dir and @target keep the real dotted name.
  local sess; sess=$(printf '%s' "$name" | tr '.:' '__')
  if "${TM[@]}" has-session -t "=$sess" 2>/dev/null; then "${TM[@]}" switch-client -t "=$sess" 2>/dev/null; return; fi
  "${TM[@]}" new-session  -d -s "$sess" -n recon -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n fuzz   -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n shell  -c "$d"
  "${TM[@]}" new-window   -t "=$sess:" -n notes  -c "$d" "${EDITOR:-vi} '$d/notes.md'"
  "${TM[@]}" set -t "=$sess:" @target "$name"    # set-option needs the trailing ':' — a bare "=$sess" fails to resolve
  "${TM[@]}" select-window -t "=$sess:recon"
  "${TM[@]}" switch-client -t "=$sess" 2>/dev/null || "${TM[@]}" attach -t "=$sess"
}

# ── burst: STAGED recon, never executed ───────────────────────────────────────
# The whole safety philosophy in one function: it types commands into panes
# and stops. I read them, I fix the scope, I press Enter myself.
#
# sensei ships no opinion about which tools you run — the chain(s) live entirely
# in burst.conf (created empty on install, never touched by updates), as one or
# more named [profile] sections, one command per line, {target} substituted in.
# Pane count is however many lines the chosen profile has — nothing is fixed.
burst_profile_names() {
  awk -F'[][]' '/^\[.+\][ \t]*$/{print $2}' "$BURST_CONF" 2>/dev/null
}
burst_profile_commands() {   # $1 = profile name
  awk -v want="$1" '
    /^\[.+\][ \t]*$/ { name=$0; gsub(/^\[|\][ \t]*$/,"",name); on=(name==want); next }
    on && NF && $0 !~ /^[ \t]*#/ { print }
  ' "$BURST_CONF" 2>/dev/null
}

cmd_burst() {
  local sess="${1:?session}" tgt="${2:-}" profile="${3:-}"
  [ -n "$tgt" ] || die "no @target set (prefix t)"
  [ -f "$BURST_CONF" ] || die "no burst profiles yet — add a [profile] section to $BURST_CONF (see README)"

  local -a profiles=()
  while IFS= read -r p; do [ -n "$p" ] && profiles+=("$p"); done < <(burst_profile_names)
  [ "${#profiles[@]}" -gt 0 ] || die "no [profile] sections found in $BURST_CONF — see README for the format"

  if [ -z "$profile" ]; then
    if [ "${#profiles[@]}" -eq 1 ]; then
      profile="${profiles[0]}"
    else
      local i=1 p; local -a menu=()
      for p in "${profiles[@]}"; do
        menu+=( "$p" "$i" "run-shell 'sensei burst \"$sess\" \"$tgt\" \"$p\"'" )
        i=$((i+1))
      done
      "${TM[@]}" display-menu -T "#[align=centre]burst profile for $tgt" -x C -y C "${menu[@]}"
      return
    fi
  fi

  local -a cmds=()
  while IFS= read -r line; do cmds+=("$line"); done < <(burst_profile_commands "$profile")
  [ "${#cmds[@]}" -gt 0 ] || die "profile '$profile' is empty or missing in $BURST_CONF"

  local safe; safe=$(printf '%s' "$tgt" | tr './:' '-')      # dots break tmux -t
  local w; w=$("${TM[@]}" new-window -P -F '#{window_id}' -t "=$sess:" -n "burst-$safe")
  local n="${#cmds[@]}" i
  for ((i = 1; i < n; i++)); do "${TM[@]}" split-window -t "$w"; done
  "${TM[@]}" select-layout -t "$w" tiled
  # collect the pane_ids in order — targeting by %id never mis-parses
  local ids; ids=$("${TM[@]}" list-panes -t "$w" -F '#{pane_id}')
  i=1
  for c in "${cmds[@]}"; do
    local rendered="${c//\{target\}/$tgt}"
    local pid; pid=$(printf '%s\n' "$ids" | sed -n "${i}p")
    if [ -n "$pid" ]; then
      # a just-split pane can land in copy-mode (e.g. the after-split-window
      # log-inherit hook races with it) — cancel any mode first or these keys
      # get read as copy-mode navigation instead of typed text and vanish
      "${TM[@]}" send-keys -t "$pid" -X cancel 2>/dev/null
      "${TM[@]}" send-keys -t "$pid" "$rendered"   # <- no Enter. Deliberate.
    fi
    i=$((i+1))
  done
  say "staged $n commands ('$profile') for $tgt — read them before you run them"
}

# ── layout persistence (no resurrect plugin) ─────────────────────────
# Fields are tab-separated (tmux emits a literal TAB in -F); window names with
# dots are fine because we target by session:index, never by name.pane. Restores geometry + cwd only —
# processes are deliberately NOT resurrected (I decide what re-runs on a target).
cmd_save() {
  local n="${1:-default}"; no_traversal "$n"; mkdir -p "$STATE"; local f="$STATE/$n.layout"; : > "$f"
  "${TM[@]}" list-panes -a -F '#{session_name}::#{window_index}::#{window_name}::#{pane_index}::#{pane_current_path}::#{window_layout}' >> "$f"
  say "saved $(wc -l < "$f") panes -> $f"
}
cmd_restore() {
  local n="${1:-default}"; no_traversal "$n"; local f="$STATE/$n.layout"; [ -f "$f" ] || die "no snapshot: $f"
  local s w wn p path lay
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    s=${line%%::*};        line=${line#*::}
    w=${line%%::*};        line=${line#*::}
    wn=${line%%::*};       line=${line#*::}
    p=${line%%::*};        line=${line#*::}
    path=${line%%::*};     line=${line#*::}
    lay=$line
    [ -n "${s:-}" ] || continue
    "${TM[@]}" has-session -t "=$s" 2>/dev/null || "${TM[@]}" new-session -d -s "$s" -n "$wn" -c "$path"
    "${TM[@]}" list-windows -t "=$s" -F '#{window_index}' | grep -qx "$w" \
      || "${TM[@]}" new-window -d -t "=$s:$w" -n "$wn" -c "$path"
    [ "$p" = "1" ] || "${TM[@]}" split-window -d -t "=$s:$w" -c "$path"
    "${TM[@]}" select-layout -t "=$s:$w" "$lay" 2>/dev/null
  done < "$f"
  say "restored $n (layout + cwd only — processes are not resurrected)"
}

# ── log hygiene ───────────────────────────────────────────────────────────────
cmd_strip() {
  local f="${1:?logfile}"
  sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\x1b\][^\x07]*\x07//g' -e 's/\r$//' "$f" \
    > "${f%.log}.clean.txt"
  say "-> ${f%.log}.clean.txt"
}

# ── one-file-per-idea experiments ───────────────────────────────────────────────
# Scaffolds a new drop-in snippet in local.d/ (see tmux-sensei.conf section 10)
# and opens it. No keybind on purpose — this is a "type it in a shell" action,
# same as setup-shell, not something you reach for mid-session.
cmd_experiment() {
  local name="${1:?experiment name}"; no_traversal "$name"
  local d="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/local.d" f
  mkdir -p "$d"
  f="$d/$name.conf"
  if [ -f "$f" ]; then
    say "already exists, opening: $f"
  else
    printf '# experiment: %s (created %s)\n# delete this file any time — nothing else depends on it. If it binds a\n# key, `unbind` it here before deleting: reload re-applies commands, it\n# does not reset state, so a stray `bind` outlives the file that added it\n# (a `set`/`setw` OPTION reverts fine on its own — this only affects binds).\n\n' \
      "$name" "$(date -u +%F)" > "$f"
    say "created $f — edit it, C-s R to try it live"
  fi
  exec "${EDITOR:-vi}" "$f"
}

# ── optional shell enhancement (NOT tmux — this touches your shell) ────────────
# Fish-style autosuggestions: type, see a greyed completion from history, press
# the right-arrow to accept. tmux can't do this (it's a shell feature), so this
# sets it up for you. bash gets prefix history-search as a fallback. Opt-in only:
# it never changes your login shell without asking.
_setup_shell_ghosttext_bash() {
  # bash: look for ble.sh first — it's the real thing (per-keystroke ghost
  # text from history that updates on every letter you type, right-arrow/End
  # to accept, same feel as fish/zsh-autosuggestions). Prefix history-search
  # on up/down is only the fallback when ble.sh isn't installed — it works
  # immediately with no packages, but it's search-on-demand, not live preview.
  local br="$HOME/.bashrc"; touch "$br"
  local ble=""
  for p in \
    /usr/share/blesh/ble.sh \
    /usr/local/share/blesh/ble.sh \
    "$HOME/.local/share/blesh/ble.sh" \
    "$(brew --prefix 2>/dev/null)/share/blesh/ble.sh"
  do [ -n "$p" ] && [ -f "$p" ] && { ble="$p"; break; }; done

  if [ -n "$ble" ]; then
    if grep -qsF "$ble" "$br"; then
      say "ble.sh already wired into ~/.bashrc"
    else
      # must be the LAST line in .bashrc — ble.sh's own requirement, so it
      # can wrap whatever bash already set up (prompt, other bindings) first
      printf '\n# tmux-sensei: ble.sh — live per-keystroke ghost text (right-arrow/End to accept)\nsource %s\n' "$ble" >> "$br"
      say "ble.sh wired into ~/.bashrc (open a new bash shell to use it)"
    fi
  else
    if ! grep -qsF 'history-search-backward' "$br"; then
      {
        printf '\n# tmux-sensei: type a few letters, press up-arrow to search history by prefix\n'
        printf 'bind '"'"'"\\e[A": history-search-backward'"'"' 2>/dev/null\n'
        printf 'bind '"'"'"\\e[B": history-search-forward'"'"' 2>/dev/null\n'
      } >> "$br"
      say "bash history-search added to ~/.bashrc (prefix-search only — see below for live ghost text)"
    else
      say "bash history-search already set up (prefix-search only — see below for live ghost text)"
    fi
    printf '\n  For the real thing — live ghost text that updates as you type — install ble.sh:\n'
    printf '    git clone --recursive https://github.com/akinomyoga/ble.sh.git ~/.local/src/ble.sh\n'
    printf '    make -C ~/.local/src/ble.sh install PREFIX=~/.local\n'
    printf '  then re-run: sensei setup-shell\n\n'
  fi
}

_setup_shell_ghosttext_zsh() {
  # zsh-autosuggestions: the real Fish-style ghost text
  if ! command -v zsh >/dev/null 2>&1; then
    printf '  For Fish-style ghost-text suggestions, install zsh:\n'
    printf '    sudo apt install zsh zsh-autosuggestions   (Debian/Kali/Ubuntu)\n'
    printf '    brew install zsh zsh-autosuggestions       (macOS)\n'
    printf '  then re-run: sensei setup-shell\n\n'
    return 0
  fi

  # find the plugin wherever the distro put it
  local plug=""
  for p in \
    /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
    /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
    "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
  do [ -f "$p" ] && { plug="$p"; break; }; done

  if [ -z "$plug" ]; then
    printf '  zsh is installed but the autosuggestions plugin is not. Install it:\n'
    printf '    sudo apt install zsh-autosuggestions\n'
    printf '  or:  git clone https://github.com/zsh-users/zsh-autosuggestions ~/.zsh/zsh-autosuggestions\n'
    printf '  then re-run: sensei setup-shell\n\n'
    return 0
  fi

  local zr="$HOME/.zshrc"; touch "$zr"
  grep -qsF "$plug" "$zr" || {
    printf '\n# tmux-sensei: Fish-style history autosuggestions (right-arrow to accept)\nsource %s\n' "$plug" >> "$zr"
    say "zsh-autosuggestions wired into ~/.zshrc"
  }

  if [ "${SHELL##*/}" != "zsh" ]; then
    printf '  zsh is ready but is not your login shell.\n'
    printf '  Make it default:  chsh -s "%s"   (then log out/in)\n' "$(command -v zsh)"
    printf '  Or just try it now:  exec zsh\n\n'
  else
    printf '  Done — open a new zsh shell (or run: exec zsh). Type, then press right-arrow.\n\n'
  fi
}

# write $3 into $1 between a pair of "# >>> tmux-sensei:$2 >>>" / "<<<" marker
# comments, replacing a previous block with the same marker if one exists —
# so re-running `sensei setup-shell` after a script update cleanly replaces
# an older version of this block instead of leaving a stale duplicate, unlike
# the ghost-text sections' simpler once-only append above.
_write_block() {  # $1=file $2=marker $3=content
  local f="$1" marker="$2" content="$3"
  local begin="# >>> tmux-sensei:$marker >>>" end="# <<< tmux-sensei:$marker <<<"
  if grep -qsF "$begin" "$f"; then
    # mktemp defaults to mode 600 -- an rc file is typically 644, and mv'ing
    # a fresh mktemp file over it would silently strip group/other read
    # access on every re-run of `sensei setup-shell`. Match the original
    # file's mode (falling back to a sane 644 if that lookup ever fails)
    # before the replace, not after -- mv is atomic, chmod-after-mv is not.
    local mode; mode="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null)"
    local tmp; tmp="$(mktemp "${f}.XXXXXX")"
    chmod "${mode:-644}" "$tmp" 2>/dev/null
    awk -v b="$begin" -v e="$end" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$f" > "$tmp" && mv "$tmp" "$f"
  fi
  printf '\n%s\n%s\n%s\n' "$begin" "$content" "$end" >> "$f"
}

# ── argument Tab-completion: real, dynamic, applies to anything on PATH ───────
# The ghost-text above only ever replays what you've typed before. This wires
# actual shell programmable completion to `sensei complete` (see the ARGUMENT
# HELP comment near the top of this file), registered as the FALLBACK
# completer — bash's `complete -D`, zsh's `-default-` — not per-command like
# a normal `complete -F func git` would be, so there is no list of tool names
# to keep in sync here: it's tried for any command that doesn't already have
# its own completion, which is every offensive-security tool that doesn't
# ship one, without sensei needing to know its name in advance. A command
# that DOES already have a real completion registered (git, docker, apt, via
# your distro's bash-completion package) keeps using that instead — this
# only fills the gap, it doesn't fight anything already working.
_setup_shell_complete_bash() {
  local br="$HOME/.bashrc"; touch "$br"
  local body
  body=$(cat <<'EOF'
# dynamic, tool-agnostic Tab-completion -- asks each command about itself
# rather than looking it up in a list (see the ARGUMENT HELP comment near
# the top of the sensei script). Registered with `complete -D`: bash's
# FALLBACK completer, tried only for a command with no completion of its
# own already, so this applies to anything on your PATH, not a fixed set.
# First Tab on a brand-new command probes and caches it (a small one-time
# pause, bounded by SENSEI_PROBE_TIMEOUT); every Tab after that is instant.
_sensei_complete() {
  local out
  out=$(sensei complete "$COMP_CWORD" "${COMP_WORDS[@]}" 2>/dev/null)
  if [ "$out" = "@@FILE@@" ]; then
    COMPREPLY=($(compgen -f -- "${COMP_WORDS[COMP_CWORD]}"))
    return
  fi
  COMPREPLY=($(printf '%s\n' "$out" | cut -f1))
}
complete -D -F _sensei_complete -o bashdefault -o default
EOF
)
  _write_block "$br" "complete" "$body"
  say "Tab-completion wired into ~/.bashrc — works for anything on PATH, not a fixed list"
}

_setup_shell_complete_zsh() {
  command -v zsh >/dev/null 2>&1 || return 0
  local zr="$HOME/.zshrc"; touch "$zr"
  local body
  body=$(cat <<'EOF'
# dynamic, tool-agnostic Tab-completion -- asks each command about itself
# rather than looking it up in a list (see the ARGUMENT HELP comment near
# the top of the sensei script). NOT registered via `compdef ... -default-`
# -- that's the textbook-documented fallback mechanism, but empirically it
# is never actually reached for a real Tab press in a stock compinit setup
# (verified with a scripted pty: a -default- completer that calls compadd
# with a distinctive candidate is simply never invoked; zsh's own _complete
# resolves an unregistered command straight to file completion first).
# What DOES work: registering as the FIRST entry in the `completer` zstyle
# chain, so it's tried before zsh's own dispatch -- it inspects the command
# itself (via `sensei complete`) and, if it has nothing to offer (command
# not on PATH, no probeable flags, wrong argument position), returns
# immediately so the rest of the chain (a tool's own real completion, then
# ordinary file completion) still runs exactly as before. Any completer
# list you've already customized (oh-my-zsh, etc.) is preserved, not
# overwritten -- this only prepends itself, once. Needs compinit already
# loaded (true for most zsh setups); if Tab does nothing at all, add
# `autoload -Uz compinit && compinit` above this. First Tab on a brand-new
# command probes and caches it (a small one-time pause); every Tab after
# that is instant.
_sensei_completer() {
  (( CURRENT > 1 )) || return 1
  local cword=$((CURRENT - 1))
  local out; out=$(sensei complete "$cword" "${words[@]}" 2>/dev/null)
  [[ -n "$out" ]] || return 1
  if [[ "$out" == "@@FILE@@" ]]; then
    _files
    return 0
  fi
  local -a cands=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    cands+=("${line%%$'\t'*}:${line#*$'\t'}")
  done <<< "$out"
  _describe sensei cands
}
local -a _sensei_existing_completers
zstyle -a ':completion:*' completer _sensei_existing_completers 2>/dev/null
if (( ${_sensei_existing_completers[(I)_sensei_completer]} == 0 )); then
  [[ ${#_sensei_existing_completers[@]} -eq 0 ]] && _sensei_existing_completers=(_complete _ignored)
  zstyle ':completion:*' completer _sensei_completer "${_sensei_existing_completers[@]}"
fi
unset _sensei_existing_completers
EOF
)
  _write_block "$zr" "complete" "$body"
  say "Tab-completion wired into ~/.zshrc — works for anything on PATH, not a fixed list"
}

# ── Tab candidates as a TEMPORARY menu, not a permanent scrollback dump ────────
# Stock bash/zsh both do the same thing when a completion has many matches:
# print every one of them straight into your terminal, which then sits there
# in scrollback forever. Harmless for a handful of filenames; genuinely bad
# for a tool like curl with 300+ flags. Both shells have a real fix, but it's
# a different mechanism per shell, and it's a global readline/zle behavior
# change (every completion, not just sensei's) -- opt-in, part of
# `sensei setup-shell`, not forced on silently.
_setup_shell_menu_bash() {
  local br="$HOME/.bashrc"; touch "$br"
  local body
  body=$(cat <<'EOF'
# rebinds Tab to CYCLE candidates in place -- each press substitutes the
# next match directly into the command line -- instead of listing them, so
# a tool with hundreds of flags never dumps hundreds of lines into
# scrollback. Shift-Tab cycles backward. Applies to every completion, not
# just sensei's.
bind 'TAB:menu-complete' 2>/dev/null
bind '"\e[Z":menu-complete-backward' 2>/dev/null
EOF
)
  _write_block "$br" "menu" "$body"
  say "Tab now cycles candidates in place in ~/.bashrc (Shift-Tab to go back) instead of listing them"
}

_setup_shell_menu_zsh() {
  command -v zsh >/dev/null 2>&1 || return 0
  local zr="$HOME/.zshrc"; touch "$zr"
  local body
  body=$(cat <<'EOF'
# turns a completion list into zsh's own interactive menu -- arrow keys to
# move, Enter to pick -- which redraws/clears instead of getting printed
# into scrollback permanently. Applies to every completion, not just
# sensei's.
zstyle ':completion:*' menu select
EOF
)
  _write_block "$zr" "menu" "$body"
  say "Tab-completion now shows a temporary interactive menu in ~/.zshrc instead of a permanent list"
}

cmd_setup_shell() {
  printf '\n  This configures your SHELL (not tmux): live history autosuggestions,\n'
  printf '  Tab-completion that asks each tool about itself — dynamically, for\n'
  printf '  anything on PATH, not a fixed list — and a temporary completion menu\n'
  printf '  instead of a permanent scrollback dump for tools with many flags.\n'
  printf '  See: sensei args <tool>   ·   C-s H\n\n'
  # bash's ble.sh (wired by ghosttext_bash below) must be the LAST line in
  # .bashrc by its own requirement -- so every other bash block goes first,
  # or a re-run would append after ble.sh's source line and break it.
  _setup_shell_complete_bash
  _setup_shell_menu_bash
  _setup_shell_ghosttext_bash
  _setup_shell_ghosttext_zsh
  _setup_shell_complete_zsh
  _setup_shell_menu_zsh
}

