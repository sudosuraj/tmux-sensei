# ── self-update ───────────────────────────────────────────────────────────────
# Pulls the latest installer from the repo and runs it. Law #1 is "nothing
# curl|bash in the config itself" — so this downloads to a real file on disk
# FIRST (same staging discipline install.sh itself uses) instead of piping
# straight into bash, and asks before executing it. The installer then stages
# its own fetches to temp, swaps only what changed, and reloads a running
# tmux. Honors SENSEI_REPO / SENSEI_BRANCH.
cmd_update() {
  local url="https://raw.githubusercontent.com/${SENSEI_REPO}/${SENSEI_BRANCH}/install.sh"
  local dl
  if command -v curl >/dev/null 2>&1; then dl="curl -fsSL";
  elif command -v wget >/dev/null 2>&1; then dl="wget -qO-";
  else die "need curl or wget to update"; fi
  local tmpdir; tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/sensei-update.XXXXXX")"
  local tmp="$tmpdir/install.sh"
  trap 'rm -rf "$tmpdir"' RETURN
  printf 'fetching install.sh from %s (%s)...\n' "$SENSEI_REPO" "$SENSEI_BRANCH"
  $dl "$url" > "$tmp" || die "fetch failed — check network and that $SENSEI_REPO is reachable"
  [ -s "$tmp" ] || die "downloaded empty install.sh — does $SENSEI_BRANCH exist?"
  printf 'staged to %s — review it before running (Law #1).\n' "$tmp"
  printf 'run it now? [y/N] '
  read -r ans
  case "$ans" in
    y|Y)
      # install.sh prefers a local clone (tmux-sensei.conf + sensei sitting in
      # the current directory) over downloading — exactly right for
      # ./install.sh run from a fresh `git clone`, but wrong here: if your
      # shell happened to be sitting inside an old clone of this repo when
      # you typed `sensei update`, it would silently reuse those stale local
      # files instead of fetching fresh ones from GitHub, then correctly (but
      # uselessly) report "already up to date" against your own outdated
      # copy. Run it from a directory that's guaranteed not to have those
      # files, so it always actually hits the network.
      ( cd "$tmpdir" && SENSEI_REPO="$SENSEI_REPO" SENSEI_BRANCH="$SENSEI_BRANCH" bash "$tmp" )
      ;;
    *) printf 'not run. inspect it yourself: less %s && bash %s\n' "$tmp" "$tmp"
       trap - RETURN ;;
  esac
}

case "${1:-}" in
  update) cmd_update ;;
  vpn) cmd_vpn ;;
  ip) cmd_ip ;;
  ipcopy) cmd_ipcopy ;;
  ipmenu) cmd_ipmenu ;;
  bufmenu) cmd_bufmenu ;;
  findall) shift; cmd_findall "$@" ;;
  cmdtime) shift; cmd_cmdtime "$@" ;;
  clip) shift; cmd_clip "$@" ;;
  log) shift; cmd_log "$@" ;;
  dump) shift; cmd_dump "$@" ;;
  notes) shift; cmd_notes "$@" ;;
  case) shift; cmd_case "$@" ;;
  burst) shift; cmd_burst "$@" ;;
  save) shift; cmd_save "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  strip) shift; cmd_strip "$@" ;;
  setup-shell) cmd_setup_shell ;;
  experiment) shift; cmd_experiment "$@" ;;
  args) shift; cmd_args "$@" ;;
  args-popup) shift; cmd_args_popup "$@" ;;
  complete) shift; cmd_complete "$@" ;;
  _lastline) shift; cmd_lastline "$@" ;;
  _toolnames) cmd_toolnames ;;
  help) cmd_help ;;
  *) sed -n '2,20p' "$0" ;;
esac
