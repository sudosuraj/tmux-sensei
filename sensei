#!/usr/bin/env bash
# sensei — the only external dependency of tmux-sensei.conf
# One script, POSIX-ish bash, no packages. Subcommands are called from keybinds
# and hooks in the config; every one of them is safe to run by hand.
#
#   sensei vpn                      -> status-bar VPN/iface indicator
#   sensei log toggle  <session>    -> arm/disarm evidence logging for a session
#   sensei log inherit <session> <pane_id>
#   sensei dump  <pane_id> <session>-> flush scrollback to the case file
#   sensei notes <session>          -> open the case notebook
#   sensei case  <name>             -> new session skeleton for a target
#   sensei burst <session> <target> [profile] -> STAGE a chain from burst.conf (never executes)
#   sensei save [name] / restore [name]
#   sensei strip <logfile>          -> ANSI-strip a log for reporting
#   sensei bufmenu                  -> numbered paste-buffer pick-list
#   sensei findall <session> <pat>  -> grep every pane's scrollback, pick-list of hits
#   sensei cmdtime <pane_id> <cmd>  -> elapsed time for the pane border
#   sensei experiment <name>        -> scaffold + open a local.d/ drop-in snippet
#   sensei args <tool> [args so far...]  -> what comes next: subcommands, flags,
#                                    value formats — from a built-in reference,
#                                    not command history (see ARGUMENT HELP below)
#   sensei args-popup <pane_id>     -> C-s H: same, in a popup, prefilled from
#                                    what's currently typed in that pane
#   sensei complete ...             -> machine-facing: feeds real Tab-completion,
#                                    wired up by `sensei setup-shell`
#
# ── ARGUMENT HELP (sensei args / C-s H / Tab-completion) ──────────────────────
# History-based ghost text (setup-shell's ble.sh/zsh-autosuggestions) only ever
# replays what you've typed before. It has nothing to say about a tool you're
# using for the first time, or the one flag in fifty you never remember. This is
# the other half: a small built-in reference (tool -> subcommands -> flags ->
# value format) for common offensive-security tools, queried live against
# whatever you've typed so far, so it can answer "what comes next here" —
# subcommand, flag, or the value a flag expects — not just "what have I typed
# before." Three ways in:
#   - Tab, for real, in your shell — `sensei setup-shell` wires up bash/zsh
#     programmable completion for every covered tool.
#   - `C-s H` — popup, prefilled from what's on the command line right now.
#   - `sensei args <tool> [...]` by hand, any time.
# Covered tools are curated, not exhaustive (see the reference embedded below,
# `_specs_builtin`). Add your own or extend a built-in one, without touching
# this script, by dropping `F|tool|sub|flags|value|desc|enum` lines (same
# format) into $SENSEI_SPECS_EXTRA — created empty on install, never
# overwritten by updates, exactly like burst.conf.
set -u
TM=(${SENSEI_TMUX:-tmux})          # socket-aware: SENSEI_TMUX="tmux -L lab" for testing
LOOT="${SENSEI_LOOT:-$HOME/loot}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sensei"
BURST_CONF="${SENSEI_BURST_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/burst.conf}"
SPECS_EXTRA="${SENSEI_SPECS_EXTRA:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sensei-args.conf}"
# no blanket `mkdir -p "$LOOT" "$STATE"` here on purpose — every function that
# actually writes into one already ensures its own path (log_arm_pane, dump,
# notes, case, save), and this script also runs as `sensei vpn`/`cmdtime` on
# every status-bar/pane-border refresh; forcing two mkdir stats on every one
# of those calls for directories they never touch is pure overhead.
SENSEI_REPO="${SENSEI_REPO:-sudosuraj/tmux-sensei}"
SENSEI_BRANCH="${SENSEI_BRANCH:-main}"

die() { printf '%s\n' "$*" >&2; exit 1; }
say() { "${TM[@]}" display-message "  $*" 2>/dev/null || printf '%s\n' "$*"; }
# guard against a case/save/restore name walking us out of LOOT/STATE via .. —
# and against a literal ' breaking the shell command cmd_case embeds it in
# (e.g. `vi '/loot/o'brien/notes.md'` — unbalanced the moment the name has one)
no_traversal() {
  case "$1" in
    *..*) die "name may not contain '..': $1" ;;
    *\'*) die "name may not contain a single quote: $1" ;;
  esac
}

# ── argument help: the tool grammar engine ─────────────────────────────────────
# A small, greppable database: one line per fact, pipe-delimited, no quoting
# rules to get wrong, readable in a diff. Three record kinds:
#   T|tool|summary                              -- a tool exists, one-line blurb
#   S|tool|subcommand|summary                   -- a tool has this subcommand
#   F|tool|subcommand|flags|value|desc|enum      -- a flag (subcommand blank = global)
# `flags` is comma-joined aliases (-p,--ports). `value` is "-" for a boolean
# flag, else a placeholder like <ports> or <file> (the substring is what
# triggers filename-completion fallback for it — see cmd_complete). `enum` is
# a comma list of the flag's actual legal values when it's a small closed set
# (severities, attack modes, ...) — empty when the value is free-form.
# Never put a literal `|` or TAB in a description; commas are fine there, only
# `flags` and `enum` are comma-split.
#
# _specs_builtin is a FUNCTION, not a top-level assignment — this script has no
# daemon, it's a fresh process every call including the status-bar's `sensei
# vpn`/`cmdtime` every 5s (see the mkdir comment up top for the same concern).
# A function body costs nothing until called; the ~150-line heredoc below only
# actually runs for the handful of subcommands that need it.
_specs_blob() {
  _specs_builtin
  [ -n "$SPECS_EXTRA" ] && [ -f "$SPECS_EXTRA" ] && cat "$SPECS_EXTRA"
  return 0
}
_spec_have_tool() {   # $1=tool
  _specs_blob | awk -F'|' -v t="$1" '$1=="T" && $2==t {f=1} END{exit !f}'
}
_spec_is_sub() {      # $1=tool $2=word
  _specs_blob | awk -F'|' -v t="$1" -v s="$2" '$1=="S" && $2==t && $3==s {f=1} END{exit !f}'
}
_spec_tool_summary() { # $1=tool
  _specs_blob | awk -F'|' -v t="$1" '$1=="T" && $2==t {print $3; exit}'
}
_spec_subs() {         # $1=tool -> "sub<TAB>desc" per line
  _specs_blob | awk -F'|' -v t="$1" '$1=="S" && $2==t {print $3"\t"$4}'
}
# every flag valid at tool[/sub], one row per alias: "alias<TAB>value<TAB>desc<TAB>enum"
# sub="" means "tool has no subcommand active yet" -> only global (blank-sub) rows.
# sub="dir" means "global rows AND dir-specific rows" -> the two scopes merge.
_spec_flags_expanded() { # $1=tool $2=sub(may be empty)
  _specs_blob | awk -F'|' -v t="$1" -v s="$2" '
    $1=="F" && $2==t && ($3=="" || $3==s) {
      n = split($4, a, ",")
      for (i = 1; i <= n; i++) print a[i]"\t"$5"\t"$6"\t"$7
    }'
}
# does $3 (a word already on the line) name a known flag at tool[/sub]? if so,
# and it takes a value, print "value<TAB>enum" so the caller knows we're now
# sitting in THAT flag's value slot, not choosing the next flag.
_spec_flag_value() {  # $1=tool $2=sub $3=flag
  _specs_blob | awk -F'|' -v t="$1" -v s="$2" -v f="$3" '
    $1=="F" && $2==t && ($3=="" || $3==s) {
      n = split($4, a, ",")
      for (i = 1; i <= n; i++) if (a[i] == f) { print $5"\t"$7; exit }
    }'
}
cmd_toolnames() { _specs_blob | awk -F'|' '$1=="T"{print $2}' | sort -u; }

